{
    // primavera against Spring Boot and its peers — the benchmark project for
    // the cajeta catalog's bench/primavera/ pages (benchmark-reference spec
    // §7.4, plan unit 19), on the shared harness dev.cajeta.bench.
    //
    //   cajeta.json                       this manifest; `cajeta bench` is the full run
    //   bench.sh                          the driver: build, run, results/<machine>/<run-id>/
    //   src/main/cajeta/bench/primavera/  the harness entry and one Benchmark per page id
    //   apps/web, apps/di                 primavera's server and DI app (own projects)
    //   competitors/<framework>/{web,di}  Spring Boot, Quarkus, Micronaut, ASP.NET Core, FastAPI
    //   contract/                         the service contract and its golden bytes
    //   di/                               the DI graph description and its generator
    //   tools/                            svc.py (launch, RSS, build timing), amend.py
    //   scripts/build-all.sh              builds every app, capped, and writes build/status
    //   test/bench_smoke.sh               the smoke test
    //
    // Run from this directory. The four capabilities are dev.cajeta.bench's
    // own (clock, filesystem, env, process); this project also starts the
    // servers, oha and its helpers through cajeta.process.
    "details": {
        "name":                "dev.cajeta.bench.primavera",
        "version":             "0.1.0",
        "description":         "primavera benchmarks: the register-user service, templates, start-up, build and DI against Spring Boot, Quarkus, Micronaut, ASP.NET Core and FastAPI",
        "license":             "Apache-2.0",
        "authors":             ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        "capabilities": ["filesystem", "clock", "env", "process"],
        "dependencies": { "dev.cajeta.bench": "0.1.1" },
        "repositories": [
            { "name": "olla", "url": "https://olla.cajeta.dev", "priority": 0 }
        ],
        "build": {
            "source-root":  "src/main/cajeta",
            "target":       "host",
            "entry-method": "bench.primavera.Main::main"
        }
    },

    "tasks": {
        "build": {
            "description": "Build the bench harness (build/primavera-bench)",
            "actions": [
                { "action": "build", "flavor": { "base": "release", "opt": "O3", "cpu": "native" },
                  "output-path": "build/primavera-bench", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "bench": {
            "description": "Build every app, then run every page id on every platform into results/<machine>/<run-id>/",
            "actions": [
                { "action": "build", "flavor": { "base": "release", "opt": "O3", "cpu": "native" },
                  "output-path": "build/primavera-bench", "id": "art" },
                // exec does not split its command string: arguments go in args.
                { "action": "exec", "command": "bash", "args": ["scripts/build-all.sh", "--no-harness"] },
                { "action": "exec", "command": "bash", "args": ["bench.sh", "--competitors", "--no-build"] }
            ]
        },

        "smoke": {
            "description": "The smoke test (test/bench_smoke.sh): every id, every platform, smoke mode",
            "actions": [
                { "action": "exec", "command": "bash", "args": ["test/bench_smoke.sh"] }
            ]
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
