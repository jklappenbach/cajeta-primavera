package bench.primavera;

import cajeta.lang.String;
import cajeta.process.Command;
import cajeta.process.ProcessResult;
import cajeta.time.Clock;
import dev.cajeta.bench.Harness;
import dev.cajeta.bench.ServiceBenchmark;

/**
 * `primavera/build-time` (Build.md): a clean build of the register-user
 * service to a runnable artifact. Each trial runs the app's clean command
 * (untimed), then its build command (`sh -c` in the app's directory, output
 * to the log), and reports the build alone (reportedNanos; notes say
 * `reported`). Maven builds run offline against a warm ~/.m2 and dotnet
 * against a restored NuGet cache, as Cajeta builds against the local Olla
 * store: dependency downloads are not timed. The check is the page's: the
 * artifact runs, which one launch to the first 200 from GET /health proves
 * after the trials (ServiceBenchmark's start, readiness and stop).
 *
 * No warmup build: a clean Cajeta build takes minutes. In smoke mode the
 * harness still runs one warmup and three trials; the warmup builds nothing,
 * the first trial builds, and the other two report the first one's time, as
 * the row's notes say.
 */
public class BuildBench extends ServiceBench {
    public int64 firstNs;
    public int32 built;
    public int32 repeated;
    public String runsNote;

    public BuildBench(String keys, int32 portBase) {
        super("build-time", "web", keys, "", portBase);
        this.firstNs = (int64) -1;
        this.built = 0;
        this.repeated = 0;
        this.runsNote = "";
        this.iterations(0, 3);
        return;
    }

    public boolean supportsVariant(String variant) {
        String b #= Apps.fieldOf(variant, "web", Apps.BUILD());
        if (b.equals("-")) {
            return false;
        }
        return super.supportsVariant(variant);
    }

    public String skipReasonFor(String variant) {
        String b #= Apps.fieldOf(variant, "web", Apps.BUILD());
        if (b.equals("-")) {
            return "no build step";
        }
        return Apps.whyNot(variant, "web");
    }

    /** Nothing starts here: the server runs once, in checkResult. */
    public void prepare(String variant) {
        this.firstNs = (int64) -1;
        this.built = 0;
        this.repeated = 0;
        this.runsNote = "";
        this.setNote(variant, "");
        this.lastVariant = "" + variant;
        return;
    }

    public void runVariant(String variant, int32 iterations) {
        this.lastVariant = "" + variant;
        int32 i = 0;
        while (i < iterations) {
            if (this.isWarmup()) {
                // no warmup build
            } else if (this.smoke && this.built >= 1) {
                this.reportedNanos(this.firstNs);
                this.repeated = this.repeated + 1;
            } else {
                String c #= Apps.fieldOf(variant, "web", Apps.CLEAN());
                if (!c.equals("-")) {
                    this.shell(variant, c, "clean");
                }
                String b #= Apps.fieldOf(variant, "web", Apps.BUILD());
                int64 t0 = Clock.nanoTime();
                this.shell(variant, b, "build");
                int64 took = Clock.nanoTime() - t0;
                this.reportedNanos(took);
                if (this.built == 0) {
                    this.firstNs = took;
                }
                this.built = this.built + 1;
            }
            i = i + 1;
        }
        this.composeNote(variant);
        return;
    }

    /** `sh -c <cmd>` in the app's directory, output appended to the log; throws unless it exits 0. */
    public void shell(String variant, String cmd, String what) {
        String d #= Apps.fieldOf(variant, "web", Apps.DIR());
        String log #= this.absLog(variant);
        String[] a = heap String[3];
        a[0] = "sh";
        a[1] = "-c";
        a[2] = "exec >>'" + log + "' 2>&1 </dev/null; " + cmd;
        Command c = heap Command(#a);
        c.workingDir(#d);
        int64 limit = (int64) 3000000;
        c.timeoutMillis(limit);
        ProcessResult r #= c.run();
        if (!r.launched()) {
            throw heap Exception("could not start sh for the " + what);
        }
        if (r.timedOut()) {
            throw heap Exception(what + " passed 3000 s");
        }
        this.lastExitCode = r.exitCode();
        if (r.exitCode() != 0) {
            String tail #= ServiceBenchmark.tailOf(log);
            throw heap Exception(what + " exited " + r.exitCode() + tail);
        }
    }

    public void composeNote(String variant) {
        String c #= Apps.fieldOf(variant, "web", Apps.CLEAN());
        String b #= Apps.fieldOf(variant, "web", Apps.BUILD());
        String s = "timed: `" + b + "` after `" + c + "` (untimed)";
        if (this.repeated > 0) {
            s = s + "; smoke: " + this.built + " build measured, its time repeated for the other "
                + this.repeated + " trial(s); the warmup built nothing";
        }
        if (!this.runsNote.isEmpty()) {
            s = s + "; " + this.runsNote;
        }
        this.setNote(variant, s);
    }

    /** The built artifact runs: one launch to the first 200 from GET /health. */
    public boolean checkResult() {
        if (this.built == 0) {
            return false;
        }
        String v = this.lastVariant;
        boolean runs = true;
        try {
            this.startService(v);
            this.runsNote = "artifact runs (first 200 after " + (this.lastReadyNanos / (int64) 1000000) + " ms)";
        } catch (Throwable e) {
            runs = false;
            String m #= Harness.messageOf(e);
            this.runsNote = "artifact did not run: " + m;
        }
        this.stopService();
        this.composeNote(v);
        return runs;
    }

    public int64 measuredPeakRssKb() {
        return (int64) -1;
    }
}
