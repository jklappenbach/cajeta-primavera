package bench.primavera;

import cajeta.codec.json.Json;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.lang.String;
import dev.cajeta.bench.detect.Sys;

/**
 * An oha-driven row (Rest.md register-user-json, Templates.md
 * templated-page). Per variant the harness starts the platform's server and
 * waits for it (ServiceBenchmark); prepare then byte-compares it against the
 * contract (contract/check.py) before any load, and a server that differs
 * fails its row. Each trial is one oha run of a fixed duration at the
 * variant's connection count, keep-alive, `-w` so requests in flight at the
 * deadline are not counted as errors; the warmup's run is shorter.
 *
 * Each trial reports oha's req/s (reportedThroughput, unit `req/s`; the row's
 * throughput is the median trial) and oha's latency (reportedStats: min =
 * fastest, median = p50, mean = average, p95 = p95; each column the median
 * over trials). Any error, or any status but the expected one, fails the row.
 * peak_rss_kb is the server's VmHWM, sampled by ServiceBenchmark while oha
 * runs.
 */
public class ThroughputBench extends ServiceBench {
    public String method;
    public String path;
    public String bodyFile;
    public String expect;
    public String probes;
    public int64[] rps;
    public int64[] p99;
    public int64 requests;
    public int32 n;
    public int32 warmSeconds;
    public int32 trialSeconds;

    public ThroughputBench(String page, String keys, String conns, int32 portBase,
                           String method, String path, String bodyFile, String expect, String probes) {
        super(page, "web", keys, conns, portBase);
        this.method = "" + method;
        this.path = "" + path;
        this.bodyFile = "" + bodyFile;
        this.expect = "" + expect;
        this.probes = "" + probes;
        this.rps = heap int64[64];
        this.p99 = heap int64[64];
        this.requests = 0;
        this.n = 0;
        this.iterations(1, 5);
        this.timeoutMillis((int64) 600000);
        if (this.smoke) {
            this.warmSeconds = 1;
            this.trialSeconds = 3;
        } else {
            this.warmSeconds = 10;
            this.trialSeconds = 30;
        }
        return;
    }

    public String unit() {
        return "req/s";
    }

    /** The harness has started the server (ServiceBenchmark.prepare); compare it with the contract before any load. */
    public void prepare(String variant) {
        this.n = 0;
        this.requests = 0;
        this.setNote(variant, "");
        super.prepare(variant);
        String[] cv = heap String[6];
        cv[0] = "python3";
        cv[1] = "contract/check.py";
        cv[2] = "--port";
        cv[3] = "" + this.port;
        cv[4] = "--only";
        cv[5] = "" + this.probes;
        Run chk #= Run.of(#cv);
        if (chk.code != 0) {
            String why #= Sys.firstLine(chk.out);
            throw heap Exception("byte comparison failed before load: " + why);
        }
        return;
    }

    // ---- one trial: one oha run -------------------------------------------

    public #String[] argvFor(String variant) {
        int32 conns = Apps.connsOf(variant);
        int32 secs = this.trialSeconds;
        if (this.isWarmup()) {
            secs = this.warmSeconds;
        }
        String oha #= ThroughputBench.ohaPath();
        String url #= "http://127.0.0.1:" + this.port + this.path;
        boolean post = this.method.equals("POST");
        int32 count = 10;
        if (post) {
            count = 18;
        }
        String[] a = heap String[count];
        a[0] = "" + oha;
        a[1] = "-z";
        a[2] = "" + secs + "s";
        a[3] = "-c";
        a[4] = "" + conns;
        a[5] = "-w";
        a[6] = "--no-tui";
        a[7] = "--output-format";
        a[8] = "json";
        if (post) {
            String body #= Sys.readText(this.bodyFile);
            a[9] = "-m";
            a[10] = "POST";
            a[11] = "-H";
            a[12] = "Authorization: Bearer bench-7f3c9a1e";
            a[13] = "-H";
            a[14] = "Content-Type: application/json";
            a[15] = "-d";
            a[16] = "" + body;
            a[17] = "" + url;
        } else {
            a[9] = "" + url;
        }
        return a;
    }

    public static #String ohaPath() {
        String o = System.env.get("OHA");
        if (o != null) {
            return "" + o;
        }
        String home = System.env.get("HOME");
        if (home == null) {
            return "oha";
        }
        return home + "/.cargo/bin/oha";
    }

    public static int64 nanos(float64 seconds) {
        return (int64) (seconds * 1000000000.0);
    }

    /** Field `name` of `o` in seconds, as nanoseconds; -1 when absent. */
    public static int64 secondsAt(JsonObject o, String name) {
        JsonValue v = o.get(name);
        if (v == null) {
            return (int64) -1;
        }
        return ThroughputBench.nanos(v.asFloat64());
    }

    /** One oha run against the running server (ServiceBenchmark samples its RSS meanwhile), then its tally. */
    public void runPhase(String variant) {
        this.runPhaseCommand(variant);
        this.tally(variant);
        return;
    }

    /** Parse the last oha run; throw on any error or unexpected status; report the trial's figures. */
    public void tally(String variant) {
        JsonValue root #= Json.parse(this.lastStdout);
        if (root == null || root.kind() != 5) {
            throw heap Exception("oha printed no JSON summary");
        }
        JsonObject top = root.object();
        JsonValue sv = top.get("summary");
        JsonObject summary = sv.object();
        JsonValue rv = summary.get("requestsPerSec");
        float64 r = rv.asFloat64();
        JsonValue ev = top.get("errorDistribution");
        int64 errors = 0;
        if (ev != null && ev.kind() == 5) {
            JsonObject eo = ev.object();
            int32 k = 0;
            while (k < eo.count()) {
                errors = errors + eo.valueAt(k).asInt64();
                k = k + 1;
            }
        }
        JsonValue cv = top.get("statusCodeDistribution");
        int64 total = 0;
        int64 good = 0;
        if (cv != null && cv.kind() == 5) {
            JsonObject co = cv.object();
            int32 k = 0;
            while (k < co.count()) {
                int64 c = co.valueAt(k).asInt64();
                total = total + c;
                k = k + 1;
            }
            JsonValue gv = co.get(this.expect);
            if (gv != null) {
                good = gv.asInt64();
            }
        }
        if (errors > 0) {
            throw heap Exception("oha reported " + errors + " errors at " + Apps.connsOf(variant)
                + " connections");
        }
        if (total == 0 || good != total) {
            throw heap Exception("oha saw " + (total - good) + " of " + total + " answers other than " + this.expect);
        }
        if (this.isWarmup()) {
            return;
        }
        JsonValue lv = top.get("latencyPercentiles");
        JsonObject lat = lv.object();
        int64 fastest = ThroughputBench.secondsAt(summary, "fastest");
        int64 p50 = ThroughputBench.secondsAt(lat, "p50");
        int64 average = ThroughputBench.secondsAt(summary, "average");
        int64 p95 = ThroughputBench.secondsAt(lat, "p95");
        this.reportedThroughput(r, "req/s");
        this.reportedStats(fastest, p50, average, p95);
        if (this.n < 64) {
            this.rps[this.n] = (int64) (r * 10.0 + 0.5);
            this.p99[this.n] = ThroughputBench.secondsAt(lat, "p99");
            this.n = this.n + 1;
        }
        this.requests = this.requests + total;
        this.composeNote(variant);
        return;
    }

    /** The row's notes, rewritten after every trial so a row that fails later still says what ran. */
    public void composeNote(String variant) {
        int32 k = this.n;
        String rl #= Stats.list(this.rps, k);
        int64[] q = heap int64[64];
        int32 i = 0;
        while (i < k) {
            q[i] = this.p99[i];
            i = i + 1;
        }
        int64 q99 = Stats.median(q, k);
        String ohaV #= Apps.tool("oha");
        String k2 #= Apps.keyOf(variant);
        String eng #= this.engineFor(k2);
        this.setNote(variant, "oha " + ohaV + " " + this.method + " " + this.path + "; "
            + Apps.connsOf(variant) + " connections; " + this.trialSeconds + " s per trial (warmup "
            + this.warmSeconds + " s); requests=" + this.requests + "; errors=0; body=equal; status="
            + this.expect + "; p99_ns=" + q99 + "; rps_tenths=" + rl
            + "; latency is oha's (min=fastest, median=p50, mean=average)" + eng);
        return;
    }

    public boolean checkResult() {
        return this.lastExitCode == 0 && this.n > 0;
    }

    /** The template engine a templated-page row renders with, for its notes. */
    public #String engineFor(String key) {
        if (!this.path.equals("/fortunes")) {
            return "";
        }
        if (key.equals("primavera")) {
            return "; engine cajeta-jinja 0.1.6";
        }
        if (key.equals("spring-boot")) {
            return "; engine Thymeleaf";
        }
        if (key.equals("quarkus-jvm")) {
            return "; engine Qute";
        }
        if (key.equals("aspnetcore")) {
            return "; engine Razor";
        }
        return "; engine Jinja2 3.1.6";
    }
}
