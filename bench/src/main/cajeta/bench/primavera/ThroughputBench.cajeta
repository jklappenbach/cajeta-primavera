package bench.primavera;

import cajeta.codec.json.Json;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.io.file.File;
import cajeta.io.file.FileWriter;
import cajeta.io.file.OpenMode;
import cajeta.lang.String;
import cajeta.process.Command;
import cajeta.process.Process;
import dev.cajeta.bench.report.Memory;
import dev.cajeta.bench.detect.Sys;

/**
 * An oha-driven row (Rest.md register-user-json, Templates.md
 * templated-page). Per platform the server is started once, waited for,
 * and byte-compared against the contract (contract/check.py) before any
 * load; a server that differs fails its rows. Each trial is one oha run of a
 * fixed duration at the variant's connection count, keep-alive, `-w` so
 * requests in flight at the deadline are not counted as errors.
 *
 * Requests per second are parsed from oha's JSON stdout onto the throughput
 * columns (unit `req/s`, the median trial); the time columns are oha's
 * latency (min = fastest, median = p50, mean = average, p95 = p95, each the
 * median over trials). Any error, or any status but the expected one, fails
 * the row. peak_rss_kb is the server's VmHWM after the trials.
 */
public class ThroughputBench extends ServiceBench {
    public String method;
    public String path;
    public String bodyFile;
    public String expect;
    public String probes;
    public String engineNote;
    public Process server;
    public String serverKey;
    public String serverError;
    public int32 serverPort;
    public int32 serverPid;
    public int64[] rps;
    public int64[] p50;
    public int64[] p95;
    public int64[] p99;
    public int64[] fastest;
    public int64[] average;
    public int64 requests;
    public int32 n;
    public int64 hwm;
    public int32 warmSeconds;
    public int32 trialSeconds;

    public ThroughputBench(String page, String ledger, String keys, String conns, int32 portBase,
                           String method, String path, String bodyFile, String expect, String probes) {
        super(page, ledger, "web", keys, conns, portBase);
        this.method = "" + method;
        this.path = "" + path;
        this.bodyFile = "" + bodyFile;
        this.expect = "" + expect;
        this.probes = "" + probes;
        this.engineNote = "";
        this.server = null;
        this.serverKey = "";
        this.serverError = "";
        this.serverPort = 0;
        this.serverPid = -1;
        this.rps = heap int64[64];
        this.p50 = heap int64[64];
        this.p95 = heap int64[64];
        this.p99 = heap int64[64];
        this.fastest = heap int64[64];
        this.average = heap int64[64];
        this.requests = 0;
        this.n = 0;
        this.hwm = -1;
        this.iterations(1, 5);
        this.timeoutMillis((int64) 600000);
        if (this.smoke) {
            this.warmSeconds = 1;
            this.trialSeconds = 3;
        } else {
            this.warmSeconds = 10;
            this.trialSeconds = 30;
        }
        return;
    }

    public String unit() {
        return "req/s";
    }

    // ---- the server ----------------------------------------------------------

    public void stopServer() {
        if (this.server != null) {
            this.server.kill();
            this.server.close();
            this.server = null;
        }
        this.serverKey = "";
        return;
    }

    public void startServer() {
        this.stopServer();
        this.serverKey = "" + this.key;
        this.serverError = "";
        int32 p = this.nextPort();
        String run #= Apps.field(this.key, "web", Apps.RUN());
        String[] words #= Apps.words(run, p);
        int32 w = (int32) words.count();
        String log #= this.absLog();
        String[] argv = heap String[w + 4];
        argv[0] = "/bin/sh";
        argv[1] = "-c";
        argv[2] = "exec \"$@\" >>'" + log + "' 2>&1";
        argv[3] = "sh";
        int32 i = 0;
        while (i < w) {
            argv[i + 4] = "" + words[i];
            i = i + 1;
        }
        Command c = heap Command(#argv);
        String d #= this.dir();
        c.workingDir(#d);
        Process pr #= c.start();
        if (!pr.launched()) {
            this.serverError = "could not start " + this.key;
            return;
        }
        int32 pid = pr.pid();
        this.server #= pr;
        this.serverPort = p;
        this.serverPid = pid;
        String pids #= this.absPids();
        FileWriter pf #= File.openWrite(pids, OpenMode.APPEND);
        pf.writeString("" + pid + " " + this.key + "\n");
        pf.close();

        String[] wv = heap String[12];
        wv[0] = "python3";
        wv[1] = "tools/svc.py";
        wv[2] = "wait";
        wv[3] = "--port";
        wv[4] = "" + p;
        wv[5] = "--pid";
        wv[6] = "" + pid;
        wv[7] = "--log";
        wv[8] = "" + log;
        wv[9] = "--timeout";
        wv[10] = "180";
        wv[11] = "--";
        Run up #= Run.of(#wv);
        if (up.code != 0) {
            String why #= up.why();
            this.serverError = this.key + " did not come up: " + why;
            return;
        }
        String[] cv = heap String[6];
        cv[0] = "python3";
        cv[1] = "contract/check.py";
        cv[2] = "--port";
        cv[3] = "" + p;
        cv[4] = "--only";
        cv[5] = "" + this.probes;
        Run chk #= Run.of(#cv);
        if (chk.code != 0) {
            String why #= Sys.firstLine(chk.out);
            this.serverError = "byte comparison failed before load: " + why;
            return;
        }
        return;
    }

    public void prepare(String variant) {
        this.begin(variant);
        this.n = 0;
        this.requests = 0;
        this.hwm = -1;
        if (!this.serverKey.equals(this.key)) {
            this.startServer();
        }
        if (!this.serverError.isEmpty()) {
            throw heap Exception("" + this.serverError);
        }
        return;
    }

    public void teardown() {
        this.stopServer();
        return;
    }

    // ---- one trial: one oha run -------------------------------------------

    public #String[] argvFor(String variant) {
        int32 conns = ServiceBench.connsOf(variant);
        int32 secs = this.trialSeconds;
        if (this.warming()) {
            secs = this.warmSeconds;
        }
        String oha #= ThroughputBench.ohaPath();
        String url #= "http://127.0.0.1:" + this.serverPort + this.path;
        boolean post = this.method.equals("POST");
        int32 count = 10;
        if (post) {
            count = 18;
        }
        String[] a = heap String[count];
        a[0] = "" + oha;
        a[1] = "-z";
        a[2] = "" + secs + "s";
        a[3] = "-c";
        a[4] = "" + conns;
        a[5] = "-w";
        a[6] = "--no-tui";
        a[7] = "--output-format";
        a[8] = "json";
        if (post) {
            String body #= Sys.readText(this.bodyFile);
            a[9] = "-m";
            a[10] = "POST";
            a[11] = "-H";
            a[12] = "Authorization: Bearer bench-7f3c9a1e";
            a[13] = "-H";
            a[14] = "Content-Type: application/json";
            a[15] = "-d";
            a[16] = "" + body;
            a[17] = "" + url;
        } else {
            a[9] = "" + url;
        }
        return a;
    }

    public static #String ohaPath() {
        String o = System.env.get("OHA");
        if (o != null) {
            return "" + o;
        }
        String home = System.env.get("HOME");
        if (home == null) {
            return "oha";
        }
        return home + "/.cargo/bin/oha";
    }

    public static int64 nanos(float64 seconds) {
        return (int64) (seconds * 1000000000.0);
    }

    /** Field `name` of `o` in seconds, as nanoseconds; -1 when absent. */
    public static int64 secondsAt(JsonObject o, String name) {
        JsonValue v = o.get(name);
        if (v == null) {
            return (int64) -1;
        }
        return ThroughputBench.nanos(v.asFloat64());
    }

    public void runVariant(String variant, int32 iterations) {
        this.lastVariant = "" + variant;
        int32 i = 0;
        while (i < iterations) {
            this.execute(variant);
            this.tally();
            this.calls = this.calls + 1;
            i = i + 1;
        }
        return;
    }

    /** Parse the last oha run; throw on any error or unexpected status. */
    public void tally() {
        JsonValue root #= Json.parse(this.lastStdout);
        if (root == null || root.kind() != 5) {
            throw heap Exception("oha printed no JSON summary");
        }
        JsonObject top = root.object();
        JsonValue sv = top.get("summary");
        JsonObject summary = sv.object();
        JsonValue rv = summary.get("requestsPerSec");
        float64 r = rv.asFloat64();
        JsonValue ev = top.get("errorDistribution");
        int64 errors = 0;
        if (ev != null && ev.kind() == 5) {
            JsonObject eo = ev.object();
            int32 k = 0;
            while (k < eo.count()) {
                errors = errors + eo.valueAt(k).asInt64();
                k = k + 1;
            }
        }
        JsonValue cv = top.get("statusCodeDistribution");
        int64 total = 0;
        int64 good = 0;
        if (cv != null && cv.kind() == 5) {
            JsonObject co = cv.object();
            int32 k = 0;
            while (k < co.count()) {
                int64 c = co.valueAt(k).asInt64();
                total = total + c;
                k = k + 1;
            }
            JsonValue gv = co.get(this.expect);
            if (gv != null) {
                good = gv.asInt64();
            }
        }
        if (errors > 0) {
            throw heap Exception("oha reported " + errors + " errors at " + ServiceBench.connsOf(this.lastVariant)
                + " connections");
        }
        if (total == 0 || good != total) {
            throw heap Exception("oha saw " + (total - good) + " of " + total + " answers other than " + this.expect);
        }
        if (this.warming()) {
            return;
        }
        if (this.n >= 64) {
            return;
        }
        JsonValue lv = top.get("latencyPercentiles");
        JsonObject lat = lv.object();
        this.rps[this.n] = (int64) (r * 10.0 + 0.5);
        this.p50[this.n] = ThroughputBench.secondsAt(lat, "p50");
        this.p95[this.n] = ThroughputBench.secondsAt(lat, "p95");
        this.p99[this.n] = ThroughputBench.secondsAt(lat, "p99");
        this.fastest[this.n] = ThroughputBench.secondsAt(summary, "fastest");
        this.average[this.n] = ThroughputBench.secondsAt(summary, "average");
        this.requests = this.requests + total;
        this.n = this.n + 1;
        return;
    }

    public boolean checkResult() {
        if (this.lastExitCode != 0 || this.n == 0) {
            return false;
        }
        String nm = this.name();
        String v = this.lastVariant;
        String lg = this.ledger;
        int32 k = this.n;
        String rl #= Stats.list(this.rps, k);
        int64 mr = Stats.median(this.rps, k);
        String tp #= Stats.tenths(mr);
        Ledger.put(lg, nm, v, "throughput", tp);
        Ledger.putInt(lg, nm, v, "min_ns", Stats.median(this.fastest, k));
        Ledger.putInt(lg, nm, v, "median_ns", Stats.median(this.p50, k));
        Ledger.putInt(lg, nm, v, "mean_ns", Stats.median(this.average, k));
        Ledger.putInt(lg, nm, v, "p95_ns", Stats.median(this.p95, k));
        Ledger.putInt(lg, nm, v, "trials", (int64) k);
        Ledger.putInt(lg, nm, v, "warmup", (int64) this.warmCount());
        String status #= "/proc/" + this.serverPid + "/status";
        this.hwm = Memory.parseIntAfterFile(status, "VmHWM:");
        Ledger.putInt(lg, nm, v, "peak_rss_kb", this.hwm);
        String ohaV #= Apps.tool("oha");
        int64 q99 = Stats.median(this.p99, k);
        Ledger.put(lg, nm, v, "notes+", "oha " + ohaV + " " + this.method + " " + this.path + "; "
            + ServiceBench.connsOf(v) + " connections; " + this.trialSeconds + " s per trial (warmup "
            + this.warmSeconds + " s); requests=" + this.requests + "; errors=0; body=equal; status="
            + this.expect + "; p99_ns=" + q99 + "; rps_tenths=" + rl + "; latency is oha's (min=fastest, median=p50, mean=average)"
            + this.engineFor(this.key));
        return true;
    }

    /** The template engine a templated-page row renders with, for its notes. */
    public #String engineFor(String key) {
        if (!this.path.equals("/fortunes")) {
            return "";
        }
        if (key.equals("primavera")) {
            return "; engine cajeta-jinja 0.1.6";
        }
        if (key.equals("spring-boot")) {
            return "; engine Thymeleaf";
        }
        if (key.equals("quarkus-jvm")) {
            return "; engine Qute";
        }
        if (key.equals("aspnetcore")) {
            return "; engine Razor";
        }
        return "; engine Jinja2 3.1.6";
    }

    public int64 measuredPeakRssKb() {
        return this.hwm;
    }
}
