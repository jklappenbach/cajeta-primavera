package bench.primavera;

import cajeta.collection.ArrayList;
import cajeta.io.file.Path;
import cajeta.lang.String;
import dev.cajeta.bench.Benchmark;
import dev.cajeta.bench.detect.Sys;

/**
 * The app table scripts/build-all.sh resolves into build/apps.tsv (one line
 * per app: key, app, language, platform, version, dir, clean, build, run),
 * the per-app build status it writes into build/status/<key>-<app>, and the
 * toolchain versions in build/toolchains.tsv. Paths are relative to bench/,
 * the directory the harness runs in.
 *
 * It also answers every row's identity from a harness variant key, `<key>`
 * or `<key>@<connections>` (primavera, spring-boot@64, ...): the language,
 * platform and versions of the key's app line, the page's variant label, the
 * flags, and why a key cannot run here. The benchmarks' dev.cajeta.bench
 * hooks (languageFor, platformFor, libraryFor, variantLabel, flagsFor,
 * supportsVariant, skipReasonFor) are these functions.
 */
public final class Apps {

    public static int32 KEY() { return 0; }
    public static int32 APP() { return 1; }
    public static int32 LANGUAGE() { return 2; }
    public static int32 PLATFORM() { return 3; }
    public static int32 VERSION() { return 4; }
    public static int32 DIR() { return 5; }
    public static int32 CLEAN() { return 6; }
    public static int32 BUILD() { return 7; }
    public static int32 RUN() { return 8; }

    /** The build/apps.tsv line for `key` and `app` ("web" or "di"), or "". */
    public static #String line(String key, String app) {
        String text #= Sys.readText("build/apps.tsv");
        String want #= key + "\t" + app + "\t";
        int32 n = text.byteLength();
        int32 at = 0;
        while (at < n) {
            int32 end = Sys.lineEnd(text, at);
            String ln #= text.substring(at, end);
            if (ln.startsWith(want)) {
                return ln;
            }
            at = end + 1;
        }
        return "";
    }

    /** Column `i` of a tab-separated line, or "". */
    public static #String col(String line, int32 i) {
        int32 n = line.byteLength();
        int32 start = 0;
        int32 k = 0;
        int32 j = 0;
        while (j <= n) {
            if (j == n || line.byteAt(j) == 9) {
                if (k == i) {
                    return line.substring(start, j);
                }
                k = k + 1;
                start = j + 1;
            }
            j = j + 1;
        }
        return "";
    }

    /** Column `i` of the app's line. */
    public static #String field(String key, String app, int32 i) {
        String ln #= Apps.line(key, app);
        return Apps.col(ln, i);
    }

    /** `ok`, `skipped: <reason>`, or "" when build-all.sh wrote no status for it. */
    public static #String status(String key, String app) {
        String path #= "build/status/" + key + "-" + app;
        Path p #= Path.of(path);
        if (!p.exists()) {
            return "";
        }
        String text #= Sys.readText(path);
        return text.trim();
    }

    /** A toolchain version from build/toolchains.tsv (`java`, `dotnet`, `python`, `cajeta`, `oha`). */
    public static #String tool(String name) {
        String text #= Sys.readText("build/toolchains.tsv");
        String want #= name + "\t";
        int32 n = text.byteLength();
        int32 at = 0;
        while (at < n) {
            int32 end = Sys.lineEnd(text, at);
            String ln #= text.substring(at, end);
            if (ln.startsWith(want)) {
                return Apps.col(ln, 1);
            }
            at = end + 1;
        }
        return "";
    }

    /** The language_version of a row in `language`. */
    public static #String languageVersion(String language) {
        if (language.equals("java")) {
            return Apps.tool("java");
        }
        if (language.equals("csharp")) {
            return Apps.tool("dotnet");
        }
        if (language.equals("python")) {
            return Apps.tool("python");
        }
        return Apps.tool("cajeta");
    }

    /** Words of `s` split on single spaces, `{port}` replaced by `port`. */
    public static #String[] words(String s, int32 port) {
        String t #= s.replace("{port}", "" + port);
        int32 n = t.byteLength();
        int32 count = 0;
        int32 j = 0;
        boolean inWord = false;
        while (j < n) {
            if (t.byteAt(j) == 32) {
                inWord = false;
            } else if (!inWord) {
                inWord = true;
                count = count + 1;
            }
            j = j + 1;
        }
        String[] out = heap String[count];
        int32 k = 0;
        int32 start = -1;
        j = 0;
        while (j <= n) {
            boolean space = j == n || t.byteAt(j) == 32;
            if (space) {
                if (start >= 0) {
                    out[k] #= t.substring(start, j);
                    k = k + 1;
                    start = -1;
                }
            } else if (start < 0) {
                start = j;
            }
            j = j + 1;
        }
        return out;
    }

    /** Leading decimal digits of the token after `label` in `text`, or -1. */
    public static int64 number(String text, String label) {
        String tok #= Sys.tokenAfter(text, label);
        int32 n = tok.byteLength();
        int64 v = 0;
        int32 i = 0;
        while (i < n) {
            int8 c = tok.byteAt(i);
            if (c < 48 || c > 57) {
                break;
            }
            v = v * 10 + (int64) (c - 48);
            i = i + 1;
        }
        if (i == 0) {
            return (int64) -1;
        }
        return v;
    }

    // ---- variants and row identity ------------------------------------------

    /** One variant key per app key (`key`, or `key@c` per connection count), filtered by CAJETA_BENCH_PLATFORMS. */
    public static #ArrayList<String> variants(String keyList, String connList) {
        ArrayList<String> v = heap ArrayList<String>();
        String[] keys #= Apps.words(keyList, 0);
        String[] conns #= Apps.words(connList, 0);
        String only = System.env.get("CAJETA_BENCH_PLATFORMS");
        int32 i = 0;
        while (i < (int32) keys.count()) {
            if (only != null && !Apps.listed(only, keys[i])) {
                i = i + 1;
                continue;
            }
            if (conns.count() == 0) {
                v.add("" + keys[i]);
            } else {
                int32 c = 0;
                while (c < (int32) conns.count()) {
                    v.add(keys[i] + "@" + conns[c]);
                    c = c + 1;
                }
            }
            i = i + 1;
        }
        return v;
    }

    /** True when `key` is one of the space- or comma-separated words of `list`. */
    public static boolean listed(String list, String key) {
        String norm #= list.replace(",", " ");
        String[] ws #= Apps.words(norm, 0);
        int32 i = 0;
        while (i < (int32) ws.count()) {
            if (ws[i].equals(key)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public static #String keyOf(String variant) {
        int64 at = variant.indexOf("@");
        if (at < 0) {
            return "" + variant;
        }
        return variant.substring(0, (int32) at);
    }

    public static int32 connsOf(String variant) {
        int64 at = variant.indexOf("@");
        if (at < 0) {
            return 0;
        }
        String c #= variant.substring((int32) at + 1, variant.byteLength());
        return (int32) Apps.number(" " + c, " ");
    }

    /** The page's variant label: `64 connections`, or "" for a single-variant page. */
    public static #String labelOf(String variant) {
        int32 c = Apps.connsOf(variant);
        if (c <= 0) {
            return "";
        }
        return "" + c + " connections";
    }

    /** Column `i` of the line of the variant's key for `app`. */
    public static #String fieldOf(String variant, String app, int32 i) {
        String k #= Apps.keyOf(variant);
        return Apps.field(k, app, i);
    }

    /** The flags column: primavera's FLAGS file for `app`, `as shipped` for a competitor. */
    public static #String flagsOf(String variant, String app) {
        String lang #= Apps.fieldOf(variant, app, Apps.LANGUAGE());
        if (!lang.equals("cajeta")) {
            return "as shipped";
        }
        String fl #= Sys.readText("apps/" + app + "/FLAGS");
        return fl.trim();
    }

    /** Why the variant's key cannot run here, or "" when it can. */
    public static #String whyNot(String variant, String app) {
        String key #= Apps.keyOf(variant);
        String ln #= Apps.line(key, app);
        if (ln.isEmpty()) {
            return "no " + app + " app for " + key + " in build/apps.tsv (run scripts/build-all.sh)";
        }
        String st #= Apps.status(key, app);
        if (st.equals("ok")) {
            return "";
        }
        if (st.isEmpty()) {
            return "no build status for " + key + "-" + app + " (run scripts/build-all.sh)";
        }
        if (st.startsWith("skipped: ")) {
            return st.substring(9, st.byteLength());
        }
        return "" + st;
    }

    /** setup(): fail without build-all.sh's output; every toolchain version into env.csv as toolchain_<name>. */
    public static void setupFor(Benchmark b) {
        String text #= Sys.readText("build/toolchains.tsv");
        if (text.isEmpty()) {
            throw heap Exception("build/toolchains.tsv is missing: run scripts/build-all.sh first");
        }
        int32 n = text.byteLength();
        int32 at = 0;
        while (at < n) {
            int32 end = Sys.lineEnd(text, at);
            String ln #= text.substring(at, end);
            String name #= Apps.col(ln, 0);
            String value #= Apps.col(ln, 1);
            if (!name.isEmpty()) {
                b.envExtra("toolchain_" + name, value);
            }
            at = end + 1;
        }
    }
}
