package bench.primavera;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import dev.cajeta.bench.BenchConfig;
import dev.cajeta.bench.ExternalBenchmark;
import dev.cajeta.bench.detect.Sys;

/**
 * One page id measured on every platform the page names. Each harness
 * variant is `<key>` or `<key>@<connections>`, where the key names the app in
 * build/apps.tsv (primavera, spring-boot, quarkus-jvm, quarkus-native,
 * micronaut-jvm, micronaut-native, aspnetcore, fastapi). The ledger renames
 * it to the page's variant label and gives the row its language, platform
 * and versions (see {@link Ledger}).
 *
 * The harness calls runVariant warmup times, then trials times, for each
 * variant after prepare(); `calls` counts them so a subclass knows which
 * phase it is in.
 */
public class ServiceBench extends ExternalBenchmark {
    public String ledger;
    public String app;
    public String keyList;
    public String connList;
    public String reason;
    public String key;
    public int32 calls;
    public int32 port;
    public int32 portBase;
    public boolean smoke;

    public ServiceBench(String page, String ledger, String app, String keys, String conns, int32 portBase) {
        this.describe(page, "primavera");
        this.ledger = "" + ledger;
        this.app = "" + app;
        this.keyList = "" + keys;
        this.connList = "" + conns;
        this.reason = "";
        this.key = "";
        this.calls = 0;
        this.portBase = portBase;
        this.port = portBase;
        this.smoke = BenchConfig.parseSmoke(System.env.get("CAJETA_BENCH_SMOKE"));
        return;
    }

    public static String SERVICE() {
        return "primavera spring-boot quarkus-jvm quarkus-native micronaut-jvm micronaut-native aspnetcore fastapi";
    }

    // ---- variants ----------------------------------------------------------

    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        String[] keys #= Apps.words(this.keyList, 0);
        String[] conns #= Apps.words(this.connList, 0);
        String only = System.env.get("CAJETA_BENCH_PLATFORMS");
        int32 i = 0;
        while (i < (int32) keys.count()) {
            if (only != null && !ServiceBench.listed(only, keys[i])) {
                i = i + 1;
                continue;
            }
            if (conns.count() == 0) {
                v.add("" + keys[i]);
            } else {
                int32 c = 0;
                while (c < (int32) conns.count()) {
                    v.add(keys[i] + "@" + conns[c]);
                    c = c + 1;
                }
            }
            i = i + 1;
        }
        return v;
    }

    /** True when `key` is one of the space- or comma-separated words of `list`. */
    public static boolean listed(String list, String key) {
        String norm #= list.replace(",", " ");
        String[] ws #= Apps.words(norm, 0);
        int32 i = 0;
        while (i < (int32) ws.count()) {
            if (ws[i].equals(key)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public static #String keyOf(String variant) {
        int64 at = variant.indexOf("@");
        if (at < 0) {
            return "" + variant;
        }
        return variant.substring(0, (int32) at);
    }

    public static int32 connsOf(String variant) {
        int64 at = variant.indexOf("@");
        if (at < 0) {
            return 0;
        }
        String c #= variant.substring((int32) at + 1, variant.byteLength());
        return (int32) Apps.number(" " + c, " ");
    }

    /** The page's variant label: `64 connections`, or "" for a single-variant page. */
    public #String label(String variant) {
        int32 c = ServiceBench.connsOf(variant);
        if (c <= 0) {
            return "";
        }
        return "" + c + " connections";
    }

    // ---- identity and skips ------------------------------------------------

    /** The row's identity onto the ledger, from the app's line. */
    public void identify(String variant) {
        String k #= ServiceBench.keyOf(variant);
        String ln #= Apps.line(k, this.app);
        String lang #= Apps.col(ln, Apps.LANGUAGE());
        String nm = this.name();
        Ledger.put(this.ledger, nm, variant, "language", lang);
        String lv #= Apps.languageVersion(lang);
        Ledger.put(this.ledger, nm, variant, "language_version", lv);
        Ledger.put(this.ledger, nm, variant, "library", k);
        String ver #= Apps.col(ln, Apps.VERSION());
        Ledger.put(this.ledger, nm, variant, "library_version", ver);
        String pl #= Apps.col(ln, Apps.PLATFORM());
        Ledger.put(this.ledger, nm, variant, "platform", pl);
        String lb #= this.label(variant);
        Ledger.put(this.ledger, nm, variant, "variant", lb);
        if (!lang.equals("cajeta")) {
            Ledger.put(this.ledger, nm, variant, "flags", "as shipped");
        } else {
            String fl #= Sys.readText("apps/" + this.app + "/FLAGS");
            String ft #= fl.trim();
            Ledger.put(this.ledger, nm, variant, "flags", ft);
        }
        return;
    }

    /** Why `key` cannot run here, or "" when it can. */
    public #String whyNot(String key) {
        String ln #= Apps.line(key, this.app);
        if (ln.isEmpty()) {
            return "no " + this.app + " app for " + key + " in build/apps.tsv (run scripts/build-all.sh)";
        }
        String st #= Apps.status(key, this.app);
        if (st.equals("ok")) {
            return "";
        }
        if (st.isEmpty()) {
            return "no build status for " + key + "-" + this.app + " (run scripts/build-all.sh)";
        }
        if (st.startsWith("skipped: ")) {
            return st.substring(9, st.byteLength());
        }
        return st;
    }

    public boolean supportsVariant(String variant) {
        this.identify(variant);
        String k #= ServiceBench.keyOf(variant);
        String why #= this.whyNot(k);
        this.reason = "" + why;
        return why.isEmpty();
    }

    public String skipReason() {
        return this.reason;
    }

    public void setup() {
        String t #= Apps.tool("cajeta");
        if (t.isEmpty()) {
            throw heap Exception("build/toolchains.tsv is missing: run scripts/build-all.sh first");
        }
        return;
    }

    // ---- per-variant phase -------------------------------------------------

    /** Start of a variant: its key, and the call count back to 0. Subclasses call it from prepare. */
    public void begin(String variant) {
        this.key #= ServiceBench.keyOf(variant);
        this.calls = 0;
        return;
    }

    public void prepare(String variant) {
        this.begin(variant);
        return;
    }

    /** The app's directory, relative to bench/. */
    public #String dir() {
        return Apps.field(this.key, this.app, Apps.DIR());
    }

    /** True in the trials (after the warmups), for the call about to run. */
    public int32 trialIndex() {
        return this.calls - this.warmCount();
    }

    /** The warmup count the harness uses (1 in smoke mode). */
    public int32 warmCount() {
        if (this.smoke) {
            return 1;
        }
        return this.warm;
    }

    public boolean warming() {
        return this.calls < this.warmCount();
    }

    /**
     * A free port not used by the previous launch, cycling through 50 from
     * portBase. The bases sit above the kernel's ephemeral range (32768 to
     * 60999 here), where a load generator's client sockets cannot take them.
     */
    public int32 nextPort() {
        int32 tries = 0;
        while (tries < 50) {
            this.port = this.port + 1;
            if (this.port >= this.portBase + 50) {
                this.port = this.portBase;
            }
            String[] a = heap String[5];
            a[0] = "python3";
            a[1] = "tools/svc.py";
            a[2] = "free";
            a[3] = "--port";
            a[4] = "" + this.port;
            Run r #= Run.of(#a);
            if (r.code == 0) {
                return this.port;
            }
            tries = tries + 1;
        }
        return this.port;
    }

    /** The log a launch of the current key writes (bench/build/logs/<page>-<key>.log). */
    public #String logPath() {
        return "build/logs/" + this.name() + "-" + this.key + ".log";
    }

    /** `log` as an absolute path: launches run in the app's directory. */
    public #String absLog() {
        String cwd = System.env.get("PWD");
        String rel #= this.logPath();
        if (cwd == null) {
            return rel;
        }
        return cwd + "/" + rel;
    }

    public #String absPids() {
        String cwd = System.env.get("PWD");
        if (cwd == null) {
            return "build/pids.txt";
        }
        return cwd + "/build/pids.txt";
    }
}
