package bench.primavera;

import cajeta.collection.ArrayList;
import cajeta.io.file.File;
import cajeta.io.file.FileWriter;
import cajeta.io.file.OpenMode;
import cajeta.lang.String;
import dev.cajeta.bench.BenchConfig;
import dev.cajeta.bench.Ports;
import dev.cajeta.bench.ServiceBenchmark;

/**
 * One page id measured on every platform the page names, on
 * dev.cajeta.bench's ServiceBenchmark: per variant the harness starts the
 * platform's server, waits for GET /health to answer 200 (polled every 1 ms),
 * runs the measured phase, samples the server's resident set, and stops it
 * by its PID (TERM, then KILL).
 *
 * Each variant key is `<key>` or `<key>@<connections>`, where the key names
 * the app in build/apps.tsv (primavera, spring-boot, quarkus-jvm,
 * quarkus-native, micronaut-jvm, micronaut-native, aspnetcore, fastapi). The
 * row's identity comes from that app line through the harness's per-variant
 * hooks (see Apps): language and its version, `library` the key and
 * `library_version` the framework's version, `platform` the framework, the
 * variant column the page's label (`64 connections`), and flags.
 *
 * Every server gets a free port of its own, cycling through 50 from the
 * page's base (61100 to 61450, above the kernel's ephemeral range, where a
 * load generator's client sockets cannot take them), and its PID goes into
 * build/pids.txt so the smoke can prove none outlived the run.
 */
public class ServiceBench extends ServiceBenchmark {
    public String app;
    public String keyList;
    public String connList;
    public int32 port;
    public int32 portBase;
    public boolean smoke;
    public String rowNote;
    public String noteVariant;

    public ServiceBench(String page, String app, String keys, String conns, int32 portBase) {
        super();
        this.describe(page, "primavera");
        this.app = "" + app;
        this.keyList = "" + keys;
        this.connList = "" + conns;
        this.portBase = portBase;
        this.port = portBase;
        this.smoke = BenchConfig.parseSmoke(System.env.get("CAJETA_BENCH_SMOKE"));
        this.rowNote = "";
        this.noteVariant = "";
        this.readyTimeoutMillis((int64) 180000);
        this.readyPollMillis(1);
        return;
    }

    public static String SERVICE() {
        return "primavera spring-boot quarkus-jvm quarkus-native micronaut-jvm micronaut-native aspnetcore fastapi";
    }

    // ---- variants and identity (dev.cajeta.bench hooks) ----------------------

    public #ArrayList<String> variants() {
        return Apps.variants(this.keyList, this.connList);
    }

    public String languageFor(String variant) {
        return Apps.fieldOf(variant, this.app, Apps.LANGUAGE());
    }

    public String languageVersionFor(String variant) {
        String lang #= Apps.fieldOf(variant, this.app, Apps.LANGUAGE());
        return Apps.languageVersion(lang);
    }

    public String platformFor(String variant) {
        return Apps.fieldOf(variant, this.app, Apps.PLATFORM());
    }

    public String libraryFor(String variant) {
        return Apps.keyOf(variant);
    }

    public String libraryVersionFor(String variant) {
        return Apps.fieldOf(variant, this.app, Apps.VERSION());
    }

    public String variantLabel(String variant) {
        return Apps.labelOf(variant);
    }

    public String flagsFor(String variant) {
        return Apps.flagsOf(variant, this.app);
    }

    public boolean supportsVariant(String variant) {
        String why #= Apps.whyNot(variant, this.app);
        return why.isEmpty();
    }

    public String skipReasonFor(String variant) {
        return Apps.whyNot(variant, this.app);
    }

    /** The row's notes: what the variant's measured phase wrote, never another variant's. */
    public String noteFor(String variant) {
        if (variant.equals(this.noteVariant)) {
            return this.rowNote;
        }
        return "";
    }

    public void setNote(String variant, String note) {
        this.noteVariant = "" + variant;
        this.rowNote = "" + note;
    }

    public void setup() {
        Apps.setupFor(this);
        return;
    }

    // ---- the service ---------------------------------------------------------

    /** The server command for `variant` on the port startService chose. */
    public #String[] serviceArgvFor(String variant) {
        String run #= Apps.fieldOf(variant, this.app, Apps.RUN());
        return Apps.words(run, this.port);
    }

    /** Start the variant's server on a fresh free port, in its app directory; record its PID. */
    public void startService(String variant) {
        int32 p = this.nextPort();
        this.readyOnUrl(p, "/health", 200);
        String d #= Apps.fieldOf(variant, this.app, Apps.DIR());
        this.serviceDirectory(d);
        String log #= this.absLog(variant);
        this.serviceLog(log);
        super.startService(variant);
        String pids #= this.absPids();
        FileWriter pf #= File.openWrite(pids, OpenMode.APPEND);
        String k #= Apps.keyOf(variant);
        pf.writeString("" + this.lastServicePid + " " + k + "\n");
        pf.close();
        return;
    }

    /**
     * The next port of the 50 from portBase that a listener can bind now
     * (Ports.isFree), skipping the one the previous server had.
     */
    public int32 nextPort() {
        int32 tries = 0;
        while (tries < 50) {
            this.port = this.port + 1;
            if (this.port >= this.portBase + 50) {
                this.port = this.portBase;
            }
            if (Ports.isFree(this.port)) {
                return this.port;
            }
            tries = tries + 1;
        }
        throw heap Exception("no free port in " + this.portBase + ".." + (this.portBase + 49));
    }

    /** The log a server of this variant writes (bench/build/logs/<page>-<key>.log), absolute: servers run in their app directory. */
    public #String absLog(String variant) {
        String k #= Apps.keyOf(variant);
        String rel #= "build/logs/" + this.name() + "-" + k + ".log";
        String cwd = System.env.get("PWD");
        if (cwd == null) {
            return rel;
        }
        return cwd + "/" + rel;
    }

    public #String absPids() {
        String cwd = System.env.get("PWD");
        if (cwd == null) {
            return "build/pids.txt";
        }
        return cwd + "/build/pids.txt";
    }
}
