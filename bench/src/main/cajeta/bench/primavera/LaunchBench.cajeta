package bench.primavera;

import cajeta.codec.json.Json;
import cajeta.codec.json.JsonObject;
import cajeta.codec.json.JsonValue;
import cajeta.collection.ArrayList;
import cajeta.io.file.Path;
import cajeta.lang.String;
import cajeta.process.ProcessResult;
import dev.cajeta.bench.ServiceBenchmark;
import dev.cajeta.bench.detect.Sys;
import dev.cajeta.bench.report.Memory;

/**
 * A row measured by launching the server afresh in every warmup and trial
 * (Startup.md), on ServiceBenchmark with relaunchEachTrial: `cold-start`
 * (exec to the first 200 from GET /health, 20 launches), `idle-rss` (the
 * resident set two seconds after that first 200), `loaded-rss` (the resident
 * set after 60 s of the contract's POST /users at 512 connections).
 *
 * The time columns are every row's exec to the first 200 (ServiceBenchmark's
 * readiness time, polled every 1 ms; notes say `reported`). The clock starts
 * just before the fork of `/bin/sh -c 'exec <server>'`, so it includes that
 * exec. peak_rss_kb is the median over launches of: VmHWM at the first 200
 * (cold-start), VmRSS 2 s later (idle-rss), VmRSS after the load
 * (loaded-rss), each summed over the server and its descendants. The server
 * is stopped by its PID, TERM then KILL after 5 s.
 */
public class LaunchBench extends ServiceBench {
    public String mode;
    public int64[] first;
    public int64[] rss;
    public int64[] hwm;
    public int64[] rpsT;
    public int32 n;
    public int32 loadSeconds;

    public LaunchBench(String page, String keys, int32 portBase, String mode) {
        super(page, "web", keys, "", portBase);
        this.mode = "" + mode;
        this.first = heap int64[64];
        this.rss = heap int64[64];
        this.hwm = heap int64[64];
        this.rpsT = heap int64[64];
        this.n = 0;
        this.timeoutMillis((int64) 600000);
        this.relaunchEachTrial(true);
        this.loadSeconds = 60;
        if (this.smoke) {
            this.loadSeconds = 3;
        }
        if (mode.equals("cold")) {
            this.iterations(1, 20);
        } else if (mode.equals("idle")) {
            this.iterations(0, 5);
        } else {
            this.iterations(0, 3);
        }
        return;
    }

    public void prepare(String variant) {
        this.n = 0;
        this.setNote(variant, "");
        super.prepare(variant);
        return;
    }

    /** loaded-rss's load: the contract's POST /users at 512 connections for loadSeconds. */
    public #String[] argvFor(String variant) {
        String oha #= ThroughputBench.ohaPath();
        String body #= Sys.readText("contract/register.json");
        String[] a = heap String[18];
        a[0] = "" + oha;
        a[1] = "-z";
        a[2] = "" + this.loadSeconds + "s";
        a[3] = "-c";
        a[4] = "512";
        a[5] = "-w";
        a[6] = "--no-tui";
        a[7] = "--output-format";
        a[8] = "json";
        a[9] = "-m";
        a[10] = "POST";
        a[11] = "-H";
        a[12] = "Authorization: Bearer bench-7f3c9a1e";
        a[13] = "-H";
        a[14] = "Content-Type: application/json";
        a[15] = "-d";
        a[16] = "" + body;
        a[17] = "http://127.0.0.1:" + this.port + "/users";
        return a;
    }

    /** Between the first 200 and the stop: settle or load, then read the resident set. */
    public void runPhase(String variant) {
        int64 atReady = ServiceBenchmark.treeHwmKb(this.lastServicePid);
        int64 rps10 = (int64) -1;
        if (this.mode.equals("idle")) {
            int64 settle = (int64) 2000;
            ProcessResult w #= this.svc.waitMillis(settle);
            if (!w.timedOut()) {
                throw heap Exception("the server exited " + w.exitCode() + " while idle");
            }
        } else if (this.mode.equals("loaded")) {
            this.runPhaseCommand(variant);
            rps10 = this.tallyLoad();
        }
        int64 now = LaunchBench.treeKb(this.lastServicePid, "VmRSS:");
        int64 peak = ServiceBenchmark.treeHwmKb(this.lastServicePid);
        if (this.isWarmup() || this.n >= 64) {
            return;
        }
        this.first[this.n] = this.lastReadyNanos;
        this.hwm[this.n] = atReady;
        if (!this.mode.equals("cold")) {
            this.hwm[this.n] = peak;
        }
        this.rss[this.n] = now;
        this.rpsT[this.n] = rps10;
        this.n = this.n + 1;
        this.composeNote(variant);
        return;
    }

    /** oha's tally after a loaded-rss load: any error or non-201 fails the row; req/s in tenths. */
    public int64 tallyLoad() {
        JsonValue root #= Json.parse(this.lastStdout);
        if (root == null || root.kind() != 5) {
            throw heap Exception("oha printed no JSON summary");
        }
        JsonObject top = root.object();
        JsonValue sv = top.get("summary");
        float64 r = sv.object().get("requestsPerSec").asFloat64();
        int64 errors = 0;
        JsonValue ev = top.get("errorDistribution");
        if (ev != null && ev.kind() == 5) {
            JsonObject eo = ev.object();
            int32 k = 0;
            while (k < eo.count()) {
                errors = errors + eo.valueAt(k).asInt64();
                k = k + 1;
            }
        }
        int64 total = 0;
        int64 good = 0;
        JsonValue cv = top.get("statusCodeDistribution");
        if (cv != null && cv.kind() == 5) {
            JsonObject co = cv.object();
            int32 k = 0;
            while (k < co.count()) {
                total = total + co.valueAt(k).asInt64();
                k = k + 1;
            }
            JsonValue gv = co.get("201");
            if (gv != null) {
                good = gv.asInt64();
            }
        }
        if (errors > 0 || total == 0 || good != total) {
            throw heap Exception("load had " + errors + " errors and " + (total - good)
                + " answers other than 201 of " + total);
        }
        return (int64) (r * 10.0 + 0.5);
    }

    /** Sum of `/proc/<pid>/status` field `label` (kB) over pid and its descendants; -1 when /proc has none. */
    public static int64 treeKb(int32 pid, String label) {
        ArrayList<int32> todo = heap ArrayList<int32>();
        todo.add(pid);
        int64 total = (int64) 0;
        boolean any = false;
        int32 seen = 0;
        while (todo.count() > 0 && seen < 256) {
            int32 p = todo.removeAt(todo.count() - 1);
            seen = seen + 1;
            int64 kb = Memory.parseIntAfterFile("/proc/" + p + "/status", label);
            if (kb >= 0) {
                total = total + kb;
                any = true;
            }
            Path taskDir #= Path.of("/proc/" + p + "/task");
            if (taskDir.isDir()) {
                ArrayList<Path> tasks #= taskDir.list();
                int32 i = 0;
                while (i < tasks.count()) {
                    Path t = tasks.get(i);
                    String tid #= t.name();
                    String kids #= Sys.readText("/proc/" + p + "/task/" + tid + "/children");
                    ServiceBenchmark.pushPids(kids, todo);
                    i = i + 1;
                }
            }
        }
        if (!any) {
            return (int64) -1;
        }
        return total;
    }

    public void composeNote(String variant) {
        int32 k = this.n;
        String rl #= Stats.list(this.rss, k);
        String hl #= Stats.list(this.hwm, k);
        String what = "";
        if (this.mode.equals("cold")) {
            what = "exec to the first 200 from GET /health, polled every 1 ms; " + k
                + " launches; peak_rss_kb is VmHWM at that 200 (median); vmhwm_kb=" + hl;
        } else if (this.mode.equals("idle")) {
            what = "peak_rss_kb is VmRSS 2 s after the first 200 (median of " + k + " launches); vmrss_kb="
                + rl + "; vmhwm_kb=" + hl + "; time columns are exec to that first 200";
        } else {
            String ohaV #= Apps.tool("oha");
            String pl #= Stats.list(this.rpsT, k);
            what = "peak_rss_kb is VmRSS after " + this.loadSeconds
                + " s of POST /users at 512 connections (oha " + ohaV + ", -w), median of " + k
                + " launches; vmrss_kb=" + rl + "; vmhwm_kb=" + hl + "; errors=0; rps_tenths=" + pl
                + "; time columns are exec to the first 200";
        }
        this.setNote(variant, what);
        return;
    }

    public boolean checkResult() {
        if (this.n == 0) {
            return false;
        }
        int32 j = 0;
        while (j < this.n) {
            if (this.first[j] <= 0 || this.rss[j] <= 0) {
                return false;
            }
            j = j + 1;
        }
        return true;
    }

    /** The median over launches of the page's figure (see the class comment). */
    public int64 measuredPeakRssKb() {
        int32 k = this.n;
        if (k == 0) {
            return (int64) -1;
        }
        int64[] a = heap int64[64];
        int32 i = 0;
        while (i < k) {
            if (this.mode.equals("cold")) {
                a[i] = this.hwm[i];
            } else {
                a[i] = this.rss[i];
            }
            i = i + 1;
        }
        return Stats.median(a, k);
    }
}
