package bench.primavera;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import dev.cajeta.bench.BenchMain;
import dev.cajeta.bench.Benchmark;

/**
 * primavera against Spring Boot and its peers (cajeta bench/primavera/): one
 * Benchmark per page id, each measuring every platform the page names; every
 * column of every row is the harness's (dev.cajeta.bench 0.1.5). Run from
 * bench/, after scripts/build-all.sh.
 */
public final class Main {

    public static int32 main(String[] args) {
        String service = ServiceBench.SERVICE();
        ArrayList<Benchmark> b = heap ArrayList<Benchmark>();
        b.add(heap ThroughputBench("register-user-json", service, "64 512", 61100,
            "POST", "/users", "contract/register.json", "201",
            "health,register,no-auth,wrong-token,missing-username,missing-password,short-username,short-password"));
        b.add(heap ThroughputBench("templated-page",
            "primavera spring-boot quarkus-jvm aspnetcore fastapi", "64", 61160,
            "GET", "/fortunes", "", "200", "health,fortunes"));
        b.add(heap LaunchBench("cold-start", service, 61220, "cold"));
        b.add(heap LaunchBench("idle-rss", service, 61280, "idle"));
        b.add(heap LaunchBench("loaded-rss", service, 61340, "loaded"));
        b.add(heap BuildBench(service, 61400));
        b.add(heap DiBench("primavera spring-boot quarkus-jvm micronaut-jvm aspnetcore fastapi"));
        return BenchMain.run(args, b);
    }
}
