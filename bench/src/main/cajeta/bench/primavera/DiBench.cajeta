package bench.primavera;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import dev.cajeta.bench.ExternalBenchmark;

/**
 * `primavera/di-graph-100-startup` (Di.md): the 100-component graph of
 * bench/di/graph.json, ten deep, generated for every framework by
 * bench/di/generate.py. Each trial runs the platform's DI app once under
 * dev.cajeta.bench's ExternalBenchmark, which times the whole process: start
 * the container, resolve the ten level-0 components, make the first injected
 * call (which reaches all 100), print, exit. peak_rss_kb is the library's,
 * one more run under /usr/bin/time. The check is the component count:
 * stdout must be `components=100 checksum=875665`. The row's identity comes
 * from the app line of the variant's key (see Apps), as on the web rows.
 */
public class DiBench extends ExternalBenchmark {
    public String keyList;
    public String rowNote;
    public String noteVariant;

    public DiBench(String keys) {
        super();
        this.describe("di-graph-100-startup", "primavera");
        this.keyList = "" + keys;
        this.rowNote = "";
        this.noteVariant = "";
        this.iterations(1, 20);
        this.timeoutMillis((int64) 120000);
        return;
    }

    public #ArrayList<String> variants() {
        return Apps.variants(this.keyList, "");
    }

    public String languageFor(String variant) {
        return Apps.fieldOf(variant, "di", Apps.LANGUAGE());
    }

    public String languageVersionFor(String variant) {
        String lang #= Apps.fieldOf(variant, "di", Apps.LANGUAGE());
        return Apps.languageVersion(lang);
    }

    public String platformFor(String variant) {
        return Apps.fieldOf(variant, "di", Apps.PLATFORM());
    }

    public String libraryFor(String variant) {
        return Apps.keyOf(variant);
    }

    public String libraryVersionFor(String variant) {
        return Apps.fieldOf(variant, "di", Apps.VERSION());
    }

    public String variantLabel(String variant) {
        return Apps.labelOf(variant);
    }

    public String flagsFor(String variant) {
        return Apps.flagsOf(variant, "di");
    }

    public boolean supportsVariant(String variant) {
        String why #= Apps.whyNot(variant, "di");
        return why.isEmpty();
    }

    public String skipReasonFor(String variant) {
        return Apps.whyNot(variant, "di");
    }

    public String noteFor(String variant) {
        if (variant.equals(this.noteVariant)) {
            return this.rowNote;
        }
        return "";
    }

    public void setup() {
        Apps.setupFor(this);
        return;
    }

    public void prepare(String variant) {
        this.noteVariant = "" + variant;
        this.rowNote = "";
        String d #= Apps.fieldOf(variant, "di", Apps.DIR());
        this.workingDirectory(d);
        return;
    }

    public #String[] argvFor(String variant) {
        String run #= Apps.fieldOf(variant, "di", Apps.RUN());
        return Apps.words(run, 0);
    }

    public boolean checkResult() {
        if (this.lastExitCode != 0) {
            return false;
        }
        boolean ok = this.lastStdout.contains("components=100 checksum=875665");
        if (ok) {
            this.rowNote = "exec to exit of the DI app, which exits right after the "
                + "first injected call printed components=100 checksum=875665";
        } else {
            String got #= this.lastStdout.trim();
            this.rowNote = "component count wrong: " + got;
        }
        return ok;
    }
}
