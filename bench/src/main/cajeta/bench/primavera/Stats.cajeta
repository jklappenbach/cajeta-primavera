package bench.primavera;

import cajeta.lang.String;
import dev.cajeta.bench.Harness;

/** Small helpers for the rows' notes: a median, a sample list. */
public final class Stats {

    /** The median of s[0..n) (sorted in place), or -1 when n is 0. */
    public static int64 median(int64[] s, int32 n) {
        if (n <= 0) {
            return (int64) -1;
        }
        Harness.sortInPlace(s, n);
        return s[n / 2];
    }

    /** Samples as `a/b/c` for the notes. */
    public static #String list(int64[] s, int32 n) {
        String out = "";
        int32 i = 0;
        while (i < n) {
            if (i > 0) {
                out = out + "/";
            }
            out = out + s[i];
            i = i + 1;
        }
        return #out;
    }
}
