{
    // The DI-at-scale app (bench/primavera/Di.md): the 100-component graph of
    // bench/di/graph.json, generated by bench/di/generate.py into
    // src/main/cajeta/bench/primavera/di/. It is the language's compile-time
    // DI, the substrate primavera builds on: the compiler wires the graph at
    // build, and the first injected call constructs it. Prints
    // `components=100 checksum=875665` and exits.
    "details": {
        "name":                "dev.cajeta.bench.primavera.di",
        "version":             "0.1.0",
        "description":         "primavera benchmark: the 100-component DI graph",
        "license":             "Apache-2.0",
        "authors":             ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },
    "settings": {
        "capabilities": [],
        "dependencies": {},
        "build": {
            "source-root":  "src/main/cajeta",
            "target":       "host",
            "entry-method": "bench.primavera.di.DiMain::main"
        }
    },
    "tasks": {
        "build": {
            "description": "Release build of the DI app (build/primavera-di)",
            "actions": [
                { "action": "build", "flavor": { "base": "release", "opt": "O3", "cpu": "native" },
                  "output-path": "build/primavera-di", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },
        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
