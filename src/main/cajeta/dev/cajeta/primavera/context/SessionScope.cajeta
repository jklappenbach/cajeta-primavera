package dev.cajeta.primavera.context;

import cajeta.concurrent.FiberLocal;

/**
 * The current session for a request (component-scopes spec §10.2).
 *
 * A session outlives any single request, so it lives in the process-wide
 * {@Link SessionStore}. What a request binds is only the session **id**, via
 * `FiberLocal`, for its dynamic extent: the web tier reads the id from the
 * transport (cookie or token) and wraps the handler in `attach(id, body)`.
 * While `body` runs, the session's {@link SessionEntry} is current, so a
 * `@Component(scope = "Session")` injected anywhere on the call path is that
 * session's instance.
 *
 * ```cajeta
 * SessionScope.configure(30 * 60 * 1000, 12 * 60 * 60 * 1000);  // idle, absolute
 * SessionScope.create(sessionId);                 // at login
 * SessionScope.attach(sessionId, () -> {
 *     Cart c = Cart.__cajeta_inject();            // this session's Cart
 * });                                             // the session persists
 * ```
 *
 * `attach` ending never frees a session's components: only `invalidate`, TTL
 * expiry, or store teardown does.
 */
public class SessionScope {
    // Process-wide session store and the per-request id binding. Owned
    // statics, never handed out.
    static SessionStore STORE = heap SessionStore();
    static FiberLocal<String> ID = heap FiberLocal<String>();

    /** Set the store's TTLs: idle and absolute, in millis, 0 disables. */
    public static void configure(int64 idleTtlMillis, int64 absoluteTtlMillis) {
        SessionScope.STORE.setIdleTtl(idleTtlMillis);
        SessionScope.STORE.setAbsoluteTtl(absoluteTtlMillis);
    }

    /** Create (or displace) the session under `sessionId`, e.g. at login. */
    public static void create(String sessionId) {
        SessionScope.STORE.create(sessionId);
    }

    /**
     * Open a session under an id the store issues and return the id (spec
     * §2.1). The id is the caller's to hand to the client.
     */
    public static #String open() {
        String id #= SessionScope.STORE.open();
        return #id;
    }

    /** Whether `sessionId` is OPEN, GONE or UNKNOWN to the store (spec §2.2). */
    public static SessionState lookup(String sessionId) {
        return SessionScope.STORE.lookup(sessionId);
    }

    /** Drop the session under `sessionId` and its components, e.g. at logout. */
    public static void invalidate(String sessionId) {
        SessionScope.STORE.invalidate(sessionId);
    }

    /** Sweep expired sessions from the store; returns the number evicted. */
    public static int32 evictExpired() {
        return SessionScope.STORE.evictExpired();
    }

    /** Drop every session ("log everyone out"). Returns the number dropped. */
    public static int32 invalidateAll() {
        return SessionScope.STORE.invalidateAll();
    }

    /**
     * Install `clock` (borrowed) as the ambient store's time source, the test
     * seam for driving session expiry deterministically. The caller OWNS
     * `clock` and must keep it alive until `useSystemClock()` (or
     * `PrimaveraTest.reset()`) restores the default, before it drops.
     */
    public static void useManualClock(ManualTimeSource clock) {
        SessionScope.STORE.setTimeSource(clock);
    }

    /** Restore the ambient store's default (system) clock. */
    public static void useSystemClock() {
        SessionScope.STORE.setTimeSource(SessionStore.systemSource());
    }

    /** Number of sessions currently in the store. */
    public static int32 sessionCount() {
        return SessionScope.STORE.count();
    }

    /**
     * Run `body` with `sessionId` bound as the current session for its
     * dynamic extent. When the store holds a live session under the id, it
     * is current while `body` runs; otherwise `body` runs sessionless, and a
     * `Session` component injected there throws `ScopeNotActiveException`.
     * The binding owns a private copy of the id.
     */
    public static void attach(String sessionId, () -> void body) {
        String owned #= sessionId.substring(0, sessionId.byteLength());
        SessionScope.ID.where(#owned, () -> SessionScope.enter(body));
    }

    static void enter(() -> void body) {
        SessionEntry e = SessionScope.STORE.resolve(SessionScope.ID.get());
        if (e == null) {
            body();
            return;
        }
        e.within(body);
        return;
    }

    /**
     * Whether a session is usable here: an id is attached AND the store
     * holds a live (non-expired) session for it.
     */
    public static boolean isActive() {
        if (SessionScope.ID.isBound() == false) {
            return false;
        }
        return SessionScope.STORE.resolve(SessionScope.ID.get()) != null;
    }
}
