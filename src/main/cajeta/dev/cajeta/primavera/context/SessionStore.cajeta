package dev.cajeta.primavera.context;

import cajeta.codec.Base64;
import cajeta.codec.Base64Exception;
import cajeta.collection.ArrayList;
import cajeta.collection.HashMap;
import cajeta.concurrent.Lock;
import cajeta.concurrent.LockGuard;
import cajeta.hash.Hash;
import cajeta.lang.stream.Stream;
import dev.cajeta.logging.Level;
import dev.cajeta.logging.Logged;
import dev.cajeta.logging.LogRecord;
import dev.cajeta.crypto.HmacSha256;
import dev.cajeta.crypto.SecureRandom;

/**
 * Owning, id-keyed store of sessions, the server-side half of the `Session`
 * scope. A session outlives any single
 * request and is shared across a client's requests, so the store is
 * process-wide state, NOT a FiberLocal binding; {@Link SessionScope} binds
 * only the session *id* to the request extent and resolves through here.
 *
 * ## Ownership
 * The backing `HashMap<String, SessionEntry>` owns its entries (toolchain
 * >= 0.9.2 element ownership): `invalidate`/expiry `remove` and `create`
 * displacement all DROP the evicted entry, and with it every `Session`
 * component it anchors; destructors run. Nothing leaks on eviction.
 *
 * ## Expiry
 * Two independent TTLs, each disabled at 0 (the default):
 *  - **idle** — expires when `now - lastAccessed` exceeds it; any resolve
 *    refreshes `lastAccessed`.
 *  - **absolute** — expires when `now - createdAt` exceeds it, regardless
 *    of activity.
 * Expiry is enforced lazily on `resolve` (an expired session reads as
 * absent and is removed on the spot) AND by `evictExpired`, the sweep an
 * idle server should run periodically so stale sessions free without
 * waiting for their next lookup.
 *
 * ## Concurrency
 * The store is shared across all in-flight requests; every public method
 * takes the internal `Lock` for the map operation (fibers park, carriers
 * don't block). The `SessionEntry` a resolve hands back is a borrow of store
 * state: it stays valid until that session is invalidated or expires.
 * v1 posture: invalidating a session that another in-flight request is
 * actively using is a caller-coordination bug — the web tier (Phase 4)
 * serializes a session's requests or defers invalidation to request end.
 *
 * ## Issued ids
 * `open()` issues an id `<epoch>.<serial>.<mac>` in base64url: this store's
 * random 8-byte epoch, a serial that advances only when an open succeeds, and
 * an HMAC-SHA256 over epoch and serial under a per-store random key, truncated
 * to 128 bits. `lookup(id)` answers OPEN for a live id, GONE for an id this
 * store issued whose session has ended, and UNKNOWN for anything else, so the
 * store accounts for every ended issued session without keeping it: the
 * answer comes from the id itself (spec §2.2, §2.3, decision §7.1).
 *
 * ## Testing
 * Two testability seams. The `...At(id, now)` forms take the timestamp
 * explicitly — fine-grained control for DIRECT store tests. The injectable
 * `TimeSource` (`setTimeSource`, default the process system clock) drives
 * the CLOCKLESS forms, so a test can control time on the AMBIENT
 * `SessionScope` path a real request takes (install a `ManualTimeSource`).
 */
@Logged
public class SessionStore {
    // Process-wide default clock, owned by the class and BORROWED by every
    // store (lifetime = process, so the borrow never dangles). Lazily built —
    // because object-typed static
    // initializers aren't reliably run before first use.
    // Concrete type (not the TimeSource interface) so the lazy null-check is a
    // class-reference compare — an interface-typed `== null` mislowers.
    static SystemTimeSource SYSTEM;

    static SystemTimeSource systemSource() {
        if (SessionStore.SYSTEM == null) {
            SystemTimeSource created = heap SystemTimeSource();
            SessionStore.SYSTEM = #created;
        }
        return SessionStore.SYSTEM;
    }

    HashMap<String, SessionEntry> sessions;
    Lock gate;
    // Borrowed, not owned: the installer owns the TimeSource (the class owns
    // SYSTEM; a test owns its ManualTimeSource). The store never drops it.
    TimeSource clock;
    int64 idleTtlMillis;
    int64 absoluteTtlMillis;
    // Issued ids (spec §7.1): the epoch tells this store's ids from any
    // other's, the key makes the MAC unforgeable, and every serial below
    // nextSerial was issued here. Serial 0 is never issued.
    int8[] epoch;
    String epochText;
    int8[] macKey;
    int64 nextSerial;
    // Live sessions `open` may hold (spec §2.5); 0 means no cap.
    int32 capacity;
    // Called once per session that leaves the store (spec §2.7).
    (String, int32) -> void observer;
    boolean observed;

    /** An eviction reason: the application ended the session (`invalidate`, `invalidateAll`). */
    public static int32 CLOSED = 1;
    /** An eviction reason: an idle or absolute TTL passed. */
    public static int32 EXPIRED = 2;
    /** An eviction reason: `create` on the session's id replaced it. */
    public static int32 DISPLACED = 3;

    public SessionStore() {
        HashMap<String, SessionEntry> created = heap HashMap<String, SessionEntry>();
        this.sessions = #created;
        Lock lock = heap Lock();
        this.gate = #lock;
        this.clock = SessionStore.systemSource();
        this.idleTtlMillis = 0;
        this.absoluteTtlMillis = 0;
        int8[] ep #= SecureRandom.bytes((int64) 8);
        String et #= Base64.encodeUrlSafe(ep, (int64) 8);
        int8[] k #= SecureRandom.bytes((int64) 32);
        this.epoch #= ep;
        this.epochText #= et;
        this.macKey #= k;
        this.nextSerial = 1;
        this.capacity = 0;
        this.observed = false;
    }

    /**
     * Call `observer` once for every session that leaves this store, with
     * its id and the reason: {@link #CLOSED}, {@link #EXPIRED} or
     * {@link #DISPLACED} (spec §2.7).
     *
     * It runs on the fiber that removed the session (a resolve or lookup, the
     * sweep, `invalidate` or `create`), after the store's lock is released,
     * so it may call back into the store. It runs inside the removed
     * session, so a `Session` component injected there is that session's
     * own; the session's components drop after it returns.
     *
     * Thread safety (§2.7.1): different sessions leaving the store at once
     * run their observers concurrently, each on its own removing fiber. An
     * observer that shares state across sessions guards it with its own lock.
     */
    public void setEvictionObserver((String, int32) -> void observer) {
        LockGuard g #= this.gate.acquire();
        this.observer #= observer;
        this.observed = true;
    }

    // Runs the observer for each removed session, outside the gate; the
    // caller drops `ev` afterwards, and with it the sessions' components.
    void notifyEvicted(Evicted ev) {
        if (!this.observed) {
            return;
        }
        (String, int32) -> void obs = this.observer;
        int32 i = 0;
        int32 n = ev.count();
        while (i < n) {
            String id = ev.ids.get(i);
            int32 reason = ev.reasons.get(i);
            SessionEntry e = ev.entries.get(i);
            e.within(() -> SessionStore.callObserver(obs, id, reason));
            i = i + 1;
        }
    }

    // A function-typed local called inside a lambda resolves as a member of
    // `this`, so the call goes through a parameter here.
    static void callObserver((String, int32) -> void obs, String id, int32 reason) {
        obs(id, reason);
    }

    /**
     * Refuse an `open` once `n` live sessions are held (spec §2.5); 0, the
     * default, sets no cap. Expired sessions not yet swept do not count: an
     * open at capacity sweeps them first. `create(id)` is not capped.
     */
    public void setCapacity(int32 n) {
        LockGuard g #= this.gate.acquire();
        this.capacity = n;
    }

    /**
     * Install the clock this store reads time through (borrowed — caller
     * retains ownership). The R1 test seam: install a ManualTimeSource to
     * drive expiry deterministically on the ambient path. Pass the system
     * source to restore production behavior.
     */
    public void setTimeSource(TimeSource source) {
        this.clock #= source;
    }

    /** Expire sessions idle longer than `millis` (0 disables, the default). */
    public void setIdleTtl(int64 millis) {
        this.idleTtlMillis = millis;
    }

    /** The idle TTL in millis, 0 when none is set. */
    public int64 idleTtl() {
        return this.idleTtlMillis;
    }

    /** Expire sessions older than `millis` regardless of activity (0 disables). */
    public void setAbsoluteTtl(int64 millis) {
        this.absoluteTtlMillis = millis;
    }

    boolean isExpired(SessionEntry e, int64 now) {
        if (this.idleTtlMillis > 0 && (now - e.lastAccessed) > this.idleTtlMillis) {
            return true;
        }
        if (this.absoluteTtlMillis > 0 && (now - e.createdAt) > this.absoluteTtlMillis) {
            return true;
        }
        return false;
    }

    /**
     * Create a fresh session bag under `id`. An existing session for the
     * same id is displaced — dropped with all its beans (the "login again"
     * semantics). The store owns a private copy of the id string.
     */
    public void createAt(String id, int64 now) {
        Evicted ev = heap Evicted();
        {
            LockGuard g #= this.gate.acquire();
            SessionEntry old = this.sessions.remove(id);
            if (old != null) {
                ev.add(id, #old, SessionStore.DISPLACED);
            }
            SessionEntry e = heap SessionEntry(now);
            String owned #= id.substring(0, id.byteLength());
            this.sessions.put(#owned, #e);
            if (log.enabled(Level.DEBUG)) {
                LogRecord r #= log.event(Level.DEBUG, "session created");
                r.str("id", id);
                log.emit(#r);
            }
        }
        this.notifyEvicted(ev);
    }

    public void create(String id) {
        this.createAt(id, this.clock.now());
    }

    /** The 128-bit MAC over (epoch, serial) under this store's key. */
    #int8[] macOf(int8[] serialBytes) {
        int8[] msg = heap int8[16];
        int32 i = 0;
        while (i < 8) {
            msg[i] = this.epoch[i];
            msg[i + 8] = serialBytes[i];
            i = i + 1;
        }
        int8[] full #= HmacSha256.mac(this.macKey, (int64) 32, msg, (int64) 16);
        int8[] mac = heap int8[16];
        i = 0;
        while (i < 16) {
            mac[i] = full[i];
            i = i + 1;
        }
        return #mac;
    }

    static #int8[] serialBytesOf(int64 serial) {
        int8[] b = heap int8[8];
        int32 i = 0;
        while (i < 8) {
            b[i] = (int8) (serial >> (int64) (56 - 8 * i));
            i = i + 1;
        }
        return #b;
    }

    /**
     * Whether this store issued `id`: its epoch is this store's, its MAC
     * verifies, and its serial is below the next one. A forged id with this
     * epoch and a plausible serial fails the MAC (spec §2.3.1). The caller
     * holds the gate (nextSerial is read under it).
     */
    boolean issuedHere(String id) {
        int64 first = id.indexOf(".");
        if (first <= (int64) 0) {
            return false;
        }
        int64 second = id.indexOfFrom(".", first + (int64) 1);
        if (second < (int64) 0 || id.indexOfFrom(".", second + (int64) 1) >= (int64) 0) {
            return false;
        }
        String ep #= id.substring(0, (int32) first);
        if (!ep.equals(this.epochText)) {
            return false;
        }
        String sp #= id.substring((int32) first + 1, (int32) second);
        String mp #= id.substring((int32) second + 1, (int32) id.byteLength());
        try {
            int8[] sb #= Base64.decode(sp);
            int8[] mb #= Base64.decode(mp);
            if (sb.count() != (int64) 8 || mb.count() != (int64) 16) {
                return false;
            }
            int8[] want #= this.macOf(sb);
            if (!Hash.constantTimeEquals(want, (int64) 16, mb, (int64) 16)) {
                return false;
            }
            int64 serial = 0;
            int32 i = 0;
            while (i < 8) {
                serial = (serial << (int64) 8) | (((int64) sb[i]) & (int64) 255);
                i = i + 1;
            }
            return serial >= (int64) 1 && serial < this.nextSerial;
        } catch (Base64Exception e) {
            return false;
        }
    }

    /**
     * Open a session under an id this store issues (spec §2.1) and return the
     * id, owned by the caller, or null when the store is at its capacity
     * (§2.5). The serial advances only here, once the session is in the
     * store, so a refusal consumes none (§2.3.2).
     */
    public #String openAt(int64 now) {
        Evicted ev = heap Evicted();
        String out = null;
        {
            // The room check and the insert share this one hold of the gate,
            // so fibers opening at once never pass the capacity (spec §2.6).
            LockGuard g #= this.gate.acquire();
            boolean room = true;
            if (this.capacity > 0 && this.sessions.count() >= (int64) this.capacity) {
                this.evictExpiredHeld(now, ev);
                if (this.sessions.count() >= (int64) this.capacity) {
                    room = false;
                    if (log.enabled(Level.DEBUG)) {
                        LogRecord r #= log.event(Level.DEBUG, "session open refused at capacity");
                        r.i64("capacity", this.capacity);
                        log.emit(#r);
                    }
                }
            }
            if (room) {
                int64 serial = this.nextSerial;
                int8[] sb #= SessionStore.serialBytesOf(serial);
                int8[] mac #= this.macOf(sb);
                String st #= Base64.encodeUrlSafe(sb, (int64) 8);
                String mt #= Base64.encodeUrlSafe(mac, (int64) 16);
                String id #= this.epochText + "." + st + "." + mt;
                String key #= id.substring(0, id.byteLength());
                SessionEntry e = heap SessionEntry(now);
                this.sessions.put(#key, #e);
                this.nextSerial = serial + (int64) 1;
                if (log.enabled(Level.DEBUG)) {
                    LogRecord r #= log.event(Level.DEBUG, "session opened");
                    r.i64("serial", serial);
                    log.emit(#r);
                }
                out #= id;
            }
        }
        this.notifyEvicted(ev);
        return #out;
    }

    public #String open() {
        String id #= this.openAt(this.clock.now());
        return #id;
    }

    /**
     * Which of OPEN, GONE or UNKNOWN `id` is (spec §2.2). OPEN refreshes the
     * idle clock, as `resolve` does; `resolve(id)` hands back the session
     * itself. A live session past its TTL is evicted here and answers as an
     * ended one. GONE and UNKNOWN never create a session (§2.4).
     */
    public SessionState lookupAt(String id, int64 now) {
        Evicted ev = null;
        SessionState state = SessionState.UNKNOWN;
        {
            LockGuard g #= this.gate.acquire();
            SessionEntry e = this.sessions.get(id);
            if (e != null) {
                if (!this.isExpired(e, now)) {
                    e.lastAccessed = now;
                    return SessionState.OPEN;
                }
                ev = heap Evicted();
                SessionEntry gone = this.sessions.remove(id);
                ev.add(id, #gone, SessionStore.EXPIRED);
                if (log.enabled(Level.DEBUG)) {
                    LogRecord r #= log.event(Level.DEBUG, "session expired on lookup");
                    r.str("id", id);
                    log.emit(#r);
                }
            }
            if (this.issuedHere(id)) {
                state = SessionState.GONE;
            }
        }
        if (ev != null) {
            this.notifyEvicted(ev);
        }
        return state;
    }

    public SessionState lookup(String id) {
        return this.lookupAt(id, this.clock.now());
    }

    /**
     * The live session under `id`, or null when there is none. Refreshes the
     * idle clock; an expired session is evicted here and reads as absent.
     * The entry is a borrow of store state, valid until the store drops it.
     */
    public SessionEntry resolveAt(String id, int64 now) {
        Evicted ev = heap Evicted();
        {
            LockGuard g #= this.gate.acquire();
            SessionEntry e = this.sessions.get(id);
            if (e == null) {
                return null;
            }
            if (!this.isExpired(e, now)) {
                e.lastAccessed = now;
                // A view of the map's slot, not of the local: `e` is a
                // binding the compiler cannot prove is a borrow.
                return this.sessions.get(id);
            }
            SessionEntry gone = this.sessions.remove(id);
            ev.add(id, #gone, SessionStore.EXPIRED);
            if (log.enabled(Level.DEBUG)) {
                LogRecord r #= log.event(Level.DEBUG, "session expired on resolve");
                r.str("id", id);
                log.emit(#r);
            }
        }
        this.notifyEvicted(ev);
        return null;
    }

    public SessionEntry resolve(String id) {
        return this.resolveAt(id, this.clock.now());
    }

    /** Whether a live (non-expired) session exists for `id`. Refreshes idle. */
    public boolean has(String id) {
        return this.resolve(id) != null;
    }

    /** Drop the session under `id` — its bag and beans free immediately. */
    public void invalidate(String id) {
        Evicted ev = heap Evicted();
        {
            LockGuard g #= this.gate.acquire();
            SessionEntry gone = this.sessions.remove(id);
            if (gone != null) {
                ev.add(id, #gone, SessionStore.CLOSED);
            }
            if (log.enabled(Level.DEBUG)) {
                LogRecord r #= log.event(Level.DEBUG, "session invalidated");
                r.str("id", id);
                log.emit(#r);
            }
        }
        this.notifyEvicted(ev);
    }

    /**
     * Sweep every expired session out of the store, dropping each evicted
     * bag. Returns the number evicted. Run this periodically (or after a
     * batch of creates) so idle-server sessions free without a lookup.
     */
    public int32 evictExpiredAt(int64 now) {
        Evicted ev = heap Evicted();
        int32 n = 0;
        {
            LockGuard g #= this.gate.acquire();
            n = this.evictExpiredHeld(now, ev);
        }
        this.notifyEvicted(ev);
        return n;
    }

    // The sweep itself, collecting what it removes into `ev`; the caller
    // holds the gate.
    int32 evictExpiredHeld(int64 now, Evicted ev) {
        // Two passes: streaming the map while removing is undefined, and the
        // streamed keys are borrows of slot state — copy the doomed ids out
        // first, then remove (each discarded remove drops its entry).
        ArrayList<String> doomed = heap ArrayList<String>();
        Stream<Pair<String, SessionEntry>> es #= this.sessions.entries();
        boolean scanning = true;
        while (scanning) {
            Optional<Pair<String, SessionEntry>> o = es.next();
            if (o.isPresent()) {
                Pair<String, SessionEntry> p = o.get();
                if (this.isExpired(p.second(), now)) {
                    String id = p.first();
                    String copy #= id.substring(0, id.byteLength());
                    doomed.add(#copy);
                }
            } else {
                scanning = false;
            }
        }
        int32 i = 0;
        int32 n = doomed.count();
        while (i < n) {
            String id = doomed.get(i);
            SessionEntry gone = this.sessions.remove(id);
            ev.add(id, #gone, SessionStore.EXPIRED);
            i = i + 1;
        }
        if (n > 0) {
            LogRecord r #= log.event(Level.INFO, "expired sessions evicted");
            r.i64("count", n);
            log.emit(#r);
        }
        return n;
    }

    public int32 evictExpired() {
        return this.evictExpiredAt(this.clock.now());
    }

    /** Number of sessions currently held (live or not-yet-swept expired). */
    public int32 count() {
        LockGuard g #= this.gate.acquire();
        return (int32) this.sessions.count();
    }

    /**
     * Drop every session — each bag and its beans free immediately. The
     * "log everyone out" operation (deploy flush, credential rotation);
     * also what test harnesses call between tests for isolation. Returns
     * the number dropped.
     */
    public int32 invalidateAll() {
        Evicted ev = heap Evicted();
        int32 n = this.invalidateAllHeld(ev);
        this.notifyEvicted(ev);
        return n;
    }

    // Removes every session into `ev` under the gate.
    int32 invalidateAllHeld(Evicted ev) {
        LockGuard g #= this.gate.acquire();
        // Same two-pass shape as evictExpiredAt: copy the ids out first —
        // streaming the map while removing is undefined.
        ArrayList<String> ids = heap ArrayList<String>();
        Stream<String> ks #= this.sessions.keys();
        boolean scanning = true;
        while (scanning) {
            Optional<String> o = ks.next();
            if (o.isPresent()) {
                String id = o.get();
                String copy #= id.substring(0, id.byteLength());
                ids.add(#copy);
            } else {
                scanning = false;
            }
        }
        int32 i = 0;
        int32 n = ids.count();
        while (i < n) {
            String id = ids.get(i);
            SessionEntry gone = this.sessions.remove(id);
            ev.add(id, #gone, SessionStore.CLOSED);
            i = i + 1;
        }
        if (n > 0) {
            LogRecord r #= log.event(Level.INFO, "all sessions invalidated");
            r.i64("count", n);
            log.emit(#r);
        }
        return n;
    }
}
