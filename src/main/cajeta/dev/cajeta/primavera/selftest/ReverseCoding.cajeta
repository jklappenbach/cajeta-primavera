package dev.cajeta.primavera.selftest;

import cajeta.lang.String;
import cajeta.wire.CompressStream;
import cajeta.wire.Compressor;
import cajeta.wire.Decompressor;
import dev.cajeta.primavera.web.ContentCodingProvider;

/**
 * A test-only content coding, `x-reverse`, that reverses the bytes: present
 * only in the test profile, negotiated with no change to primavera or
 * `cajeta-http` (spec §11.6).
 */
@Component
@Profile("test")
public final class ReverseCoding implements ContentCodingProvider {

    public ReverseCoding() {
        return;
    }

    public String token() { return "x-reverse"; }

    public #Compressor compressor() { return heap Reverser(); }

    public #Decompressor decompressor() { return heap Reverser(); }
}

/** Reverses `src[0 .. len)` both ways. */
final class Reverser implements Compressor, Decompressor {

    Reverser() {
        return;
    }

    static #int8[] flip(int8[] src, int64 len) {
        int32 n = (int32) len;
        int8[] out = heap int8[n];
        int32 i = 0;
        while (i < n) {
            out[i] = src[n - 1 - i];
            i = i + 1;
        }
        return #out;
    }

    public #int8[] compress(int8[] src) { return Reverser.flip(src, src.count()); }

    public #int8[] compress(int8[] src, int64 len, int32 level) { return Reverser.flip(src, len); }

    public #CompressStream stream(int32 level) { return null; }

    public #int8[] decompress(int8[] src, int64 expandedLen) { return Reverser.flip(src, src.count()); }

    public #int8[] decompress(int8[] src, int64 len, int64 maxOut) { return Reverser.flip(src, len); }
}
