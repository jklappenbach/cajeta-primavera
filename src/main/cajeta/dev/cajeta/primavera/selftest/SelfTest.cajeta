package dev.cajeta.primavera.selftest;

import cajeta.error.ScopeNotActiveException;
import dev.cajeta.primavera.Primavera;
import dev.cajeta.primavera.context.SessionEntry;
import dev.cajeta.primavera.context.SessionScope;
import dev.cajeta.primavera.context.SessionStore;
import dev.cajeta.primavera.context.ManualTimeSource;
import dev.cajeta.primavera.test.PrimaveraTest;
import dev.cajeta.unit.Assert;
import dev.cajeta.unit.TestRunner;
import cajeta.concurrent.AtomicInt32;

/**
 * primavera's runtime self-test, on cajeta-unit's TestRunner: the `Request`
 * and `Session` scopes primavera publishes (component-scopes spec §10), the
 * session store's lifecycle and TTL expiry, and the fiber rules (a structured
 * child shares the request, an unrelated fiber sees none).
 *
 * Test bodies mutate only static state (no mutable local capture in
 * closures); spawned probe workers record what they observed into statics
 * and the test asserts after the scope joins.
 *
 * Session expiry is tested deterministically through SessionStore's `...At`
 * methods, which take the timestamp explicitly.
 *
 * Entry: `dev.cajeta.primavera.selftest.SelfTest.run` (returns 0 = all green).
 */
public class SelfTest {
    static AtomicInt32 firstTouchTags = heap AtomicInt32(0);
    static AtomicInt32 firstTouchHits = heap AtomicInt32(0);

    // Probe-worker observations (reset before each fiber test).
    static int32 workerTag;
    static int32 seenTag;
    static int32 seenCount;
    static boolean refused;

    /** Assert with a label: fails the enclosing test with `label` as message. */
    static void req(boolean cond, String label) {
        if (cond == false) {
            Assert.fail(label);
        }
    }

    // The tag of the current request's probe, or -1 when no request is active.
    static int32 requestTag() {
        try {
            RequestProbe p = RequestProbe.__cajeta_inject();
            return p.tag;
        } catch (ScopeNotActiveException e) {
            return -1;
        }
    }

    static void touchSession(int32 by) {
        SessionProbe p = SessionProbe.__cajeta_inject();
        p.count = p.count + by;
        SelfTest.seenTag = p.tag;
        SelfTest.seenCount = p.count;
        return;
    }

    static void failRequest() {
        RequestProbe p = RequestProbe.__cajeta_inject();
        throw heap Exception("request failed after building its probe");
    }

    static void addRequestScopeTests(TestRunner t) {
        t.test("a Request component outside every request is refused", () -> {
            SelfTest.req(SelfTest.requestTag() == -1, "injection outside a request throws ScopeNotActiveException");
        });

        t.test("a Request component is one per request and freed at its end", () -> {
            RequestProbe.reset();
            PrimaveraTest.request(() -> {
                RequestProbe a = RequestProbe.__cajeta_inject();
                RequestProbe b = RequestProbe.__cajeta_inject();
                SelfTest.req(a.tag == b.tag, "two injections in one request get one instance");
                SelfTest.req(RequestProbe.dropped() == 0, "the probe lives for the whole request");
                SelfTest.seenTag = a.tag;
            });
            SelfTest.req(RequestProbe.dropped() == 1, "the request's end frees its probe");
            PrimaveraTest.request(() -> {
                SelfTest.req(SelfTest.requestTag() != SelfTest.seenTag, "the next request builds its own");
            });
            SelfTest.req(RequestProbe.built() == 2 && RequestProbe.dropped() == 2, "one build and one drop per request");
        });

        t.test("a Request component is freed when the request throws", () -> {
            RequestProbe.reset();
            boolean threw = false;
            try {
                PrimaveraTest.request(() -> SelfTest.failRequest());
            } catch (Exception e) {
                threw = true;
            }
            SelfTest.req(threw, "the request's exception reaches the caller");
            SelfTest.req(RequestProbe.built() == 1 && RequestProbe.dropped() == 1, "the thrown request still frees its probe");
        });
    }

    static void addSessionStoreTests(TestRunner t) {
        t.test("idle TTL: resolve refreshes; going idle expires and drops", () -> {
            SessionProbe.reset();
            SessionStore store = heap SessionStore();
            store.setIdleTtl(1000);
            store.createAt("s1", 1000);

            SessionEntry e = store.resolveAt("s1", 1500);
            SelfTest.req(e != null, "resolve within idle TTL");
            e.within(() -> SelfTest.touchSession(1));

            SelfTest.req(store.resolveAt("s1", 2400) != null, "idle clock refreshed by resolve");
            SelfTest.req(store.resolveAt("s1", 3500) == null, "idle-expired session reads absent");
            SelfTest.req(SessionProbe.dropped() == 1, "idle expiry drops the session's component");
            SelfTest.req(store.count() == 0, "expired session evicted on resolve");
        });

        t.test("absolute TTL expires despite activity", () -> {
            SessionStore store = heap SessionStore();
            store.setAbsoluteTtl(1000);
            store.createAt("s1", 0);
            SelfTest.req(store.resolveAt("s1", 900) != null, "live within absolute TTL");
            SelfTest.req(store.resolveAt("s1", 1500) == null, "expired despite recent access");
        });

        t.test("eviction sweep drops exactly the expired sessions", () -> {
            SessionProbe.reset();
            SessionStore store = heap SessionStore();
            store.setIdleTtl(1000);
            store.createAt("s1", 0);
            store.createAt("s2", 0);
            store.createAt("s3", 5000);
            SessionEntry e = store.resolveAt("s1", 0);
            e.within(() -> SelfTest.touchSession(1));

            SelfTest.req(store.evictExpiredAt(6000) == 2, "sweep evicts the two expired");
            SelfTest.req(store.count() == 1, "fresh session survives the sweep");
            SelfTest.req(SessionProbe.dropped() == 1, "sweep drops evicted sessions' components");
        });

        t.test("invalidate and re-create displacement both drop", () -> {
            SessionProbe.reset();
            SessionStore store = heap SessionStore();
            store.createAt("s1", 0);
            SessionEntry displaced = store.resolveAt("s1", 0);
            displaced.within(() -> SelfTest.touchSession(1));

            store.createAt("s1", 10);
            SelfTest.req(SessionProbe.dropped() == 1, "re-create displaces and drops the old session");

            SessionEntry fresh = store.resolveAt("s1", 10);
            fresh.within(() -> SelfTest.touchSession(1));
            store.invalidate("s1");
            SelfTest.req(SessionProbe.dropped() == 2, "invalidate drops the session's component");
            SelfTest.req(store.resolveAt("s1", 10) == null, "invalidated session reads absent");
        });

        t.test("invalidateAll drops every session", () -> {
            SessionProbe.reset();
            SessionStore store = heap SessionStore();
            store.createAt("a", 0);
            store.createAt("b", 0);
            SessionEntry e = store.resolveAt("a", 0);
            e.within(() -> SelfTest.touchSession(1));

            SelfTest.req(store.invalidateAll() == 2, "both sessions dropped");
            SelfTest.req(store.count() == 0, "store empty afterward");
            SelfTest.req(SessionProbe.dropped() == 1, "invalidateAll drops the components");
        });
    }

    static void addSessionScopeTests(TestRunner t) {
        t.test("a Session component survives across requests in one session", () -> {
            PrimaveraTest.reset();
            SessionProbe.reset();

            SelfTest.req(SessionScope.isActive() == false, "no session active unattached");

            PrimaveraTest.freshSession("sess-A", () -> {
                SelfTest.req(SessionScope.isActive(), "session active inside attach");
                SelfTest.touchSession(11);
            });
            SelfTest.req(SessionProbe.dropped() == 0, "attach end does NOT drop the session's component");
            int32 firstTag = SelfTest.seenTag;

            PrimaveraTest.resumeSession("sess-A", () -> SelfTest.touchSession(1));
            SelfTest.req(SelfTest.seenTag == firstTag, "a later request gets the same instance");
            SelfTest.req(SelfTest.seenCount == 12, "the instance keeps its state across requests");
            SelfTest.req(SessionProbe.built() == 1, "built once for the session");

            SelfTest.refused = false;
            PrimaveraTest.resumeSession("sess-B", () -> {
                SelfTest.req(SessionScope.isActive() == false, "unknown id is not a live session");
                try {
                    SessionProbe p = SessionProbe.__cajeta_inject();
                } catch (ScopeNotActiveException e) {
                    SelfTest.refused = true;
                }
            });
            SelfTest.req(SelfTest.refused, "an unknown session has no Session components");
        });

        t.test("sessions are isolated; invalidate and reset drop their components", () -> {
            PrimaveraTest.reset();
            SessionProbe.reset();

            PrimaveraTest.freshSession("sess-A", () -> SelfTest.touchSession(11));
            PrimaveraTest.freshSession("sess-C", () -> SelfTest.touchSession(1));
            SelfTest.req(SelfTest.seenCount == 1, "sessions are isolated");
            SelfTest.req(SessionProbe.built() == 2, "each session builds its own");

            SessionScope.invalidate("sess-A");
            SelfTest.req(SessionProbe.dropped() == 1, "invalidate drops the session's component");
            PrimaveraTest.reset();
            SelfTest.req(SessionProbe.dropped() == 2, "reset drops the rest");
            SelfTest.req(SessionScope.sessionCount() == 0, "reset leaves the store empty");
        });
    }

    static void addClockSeamTests(TestRunner t) {
        t.test("ambient session expiry via injected manual clock", () -> {
            PrimaveraTest.reset();
            SessionProbe.reset();

            // Test owns the clock; the store borrows it (restored before drop).
            ManualTimeSource clk = heap ManualTimeSource(1000);
            SessionScope.useManualClock(clk);
            SessionScope.configure(1000, 0);   // idle TTL 1000ms

            SessionScope.create("m1");
            PrimaveraTest.resumeSession("m1", () -> {
                SelfTest.req(SessionScope.isActive(), "session live at t=1000 (ambient path)");
                SelfTest.touchSession(1);
            });

            clk.advance(1500);   // t=2500, 1500ms since last access at 1000
            PrimaveraTest.resumeSession("m1", () -> {
                SelfTest.req(SessionScope.isActive() == false, "idle-expired on the ambient path");
            });
            SelfTest.req(SessionProbe.dropped() == 1, "ambient expiry dropped the session's component");

            // Restore the system clock BEFORE clk drops (the borrow contract).
            SessionScope.useSystemClock();
        });
    }

    // ---- fiber rules (component-scopes spec 4.11 to 4.13) ----

    static async void firstTouchProbe() {
        int32 tag = SelfTest.firstTouchTags.fetchAdd(1) + 100;
        PrimaveraTest.request(() -> {
            RequestProbe a = RequestProbe.__cajeta_inject();
            RequestProbe b = RequestProbe.__cajeta_inject();
            if (a.tag == b.tag) { SelfTest.firstTouchHits.fetchAdd(1); }
        });
        String sid = "first-touch-" + tag;
        SessionScope.create(sid);
        SessionScope.attach(sid, () -> {
            SessionProbe a = SessionProbe.__cajeta_inject();
            SessionProbe b = SessionProbe.__cajeta_inject();
            if (a.tag == b.tag) { SelfTest.firstTouchHits.fetchAdd(1); }
        });
        SessionScope.invalidate(sid);
    }

    static void addFirstTouchTests(TestRunner t) {
        t.test("first touch of both scopes from eight parallel fibers", () -> {
            RequestProbe.reset();
            SessionProbe.reset();
            SelfTest.firstTouchHits.store(0);
            scope {
                for (int32 i = 0; i < 8; i = i + 1) {
                    spawn firstTouchProbe();
                }
            }
            SelfTest.req(SelfTest.firstTouchHits.load() == 16, "every fiber saw one instance in both scopes");
            SelfTest.req(RequestProbe.dropped() == 8 && SessionProbe.dropped() == 8, "every request and session freed its component");
        });
    }

    static async void unrelatedWorkerProbe() {
        SelfTest.workerTag = SelfTest.requestTag();
    }

    static async void structuredChildProbe() {
        SelfTest.workerTag = SelfTest.requestTag();
    }

    static void addFiberTests(TestRunner t) {
        t.test("an unrelated fiber sees no request", () -> {
            SelfTest.workerTag = 0;
            scope {
                spawn unrelatedWorkerProbe();
            }
            SelfTest.req(SelfTest.workerTag == -1, "no request leaks to an unrelated fiber");
        });

        t.test("a structured child fiber shares the request", () -> {
            RequestProbe.reset();
            SelfTest.workerTag = 0;
            PrimaveraTest.request(() -> {
                SelfTest.seenTag = SelfTest.requestTag();
                scope {
                    spawn structuredChildProbe();
                }
            });
            SelfTest.req(SelfTest.workerTag == SelfTest.seenTag, "the child injects the request's instance");
            SelfTest.req(RequestProbe.dropped() == 1, "freed at request end, after the join");
        });
    }

    public static int32 run() {
        System.stdout.println("== primavera self-tests ==");
        TestRunner t = heap TestRunner();

        SelfTest.addFirstTouchTests(t);
        SelfTest.addRequestScopeTests(t);
        SelfTest.addSessionStoreTests(t);
        SelfTest.addSessionScopeTests(t);
        SelfTest.addClockSeamTests(t);
        SelfTest.addFiberTests(t);
        // primavera-web 7.1.1: the version a consumer reads at run time is the
        // release's. scripts/version-gate.sh holds the manifest to the same string.
        t.test("Primavera.version() is the release's version", () -> {
            Assert.equals("0.3.0", Primavera.version());
        });
        PipelineSelfTest.add(t);
        WebSelfTest.add(t);
        WsSelfTest.add(t);
        CodecSelfTest.add(t);
        IdentitySelfTest.add(t);
        SecuritySelfTest.add(t);

        return t.summary();
    }
}
