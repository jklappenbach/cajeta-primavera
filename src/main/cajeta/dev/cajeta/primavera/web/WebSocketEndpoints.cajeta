package dev.cajeta.primavera.web;

import cajeta.collection.ArrayList;
import cajeta.lang.String;
import dev.cajeta.http.ws.WsUpgrade;

/**
 * A server's WebSocket paths (primavera-web spec §6). Each path is a GET
 * route on the HTTP pipeline that upgrades; after the 101 the connection runs
 * as a {@link Connection}, whose messages are indexed as JSON over the
 * connection's buffer and handed to the path's handler. The HTTP pipeline is
 * left as it was built (spec §7.17).
 *
 * Every connection has a send queue of `queueBytes` bytes, each message
 * counting its payload plus 4 (1 MiB unless set). A send that would pass the
 * bound, or one message larger than it, is refused and the connection closes
 * with `overflowCode` (primavera-live-sessions spec §4).
 */
public final class WebSocketEndpoints {
    ArrayList<WebSocketEndpoint> list;
    int32 bound;
    int32 overflow;

    public WebSocketEndpoints() {
        this.list = heap ArrayList<WebSocketEndpoint>();
        this.bound = 1048576;
        this.overflow = 1008;
        return;
    }

    /**
     * Bytes a connection may have queued before a send is refused and it is
     * closed: each message counts its payload plus 4, framing excluded
     * (1 MiB unless set). Replaces 0.4.0's message-count `queueBound(n)`.
     */
    public WebSocketEndpoints queueBytes(int32 n) {
        this.bound = n;
        return this;
    }

    /** The send bound in bytes. */
    public int32 queueBytesBound() { return this.bound; }

    /** The close code for a connection whose queue overflows (1008, policy violation, unless set). */
    public WebSocketEndpoints overflowCode(int32 code) {
        this.overflow = code;
        return this;
    }

    /** Accepts WebSocket connections on `path`; each message is JSON, indexed in place. */
    public WebSocketEndpoints json(String path, (Connection, JsonBody) -> void handler) {
        WebSocketEndpoint e = heap WebSocketEndpoint(path, handler);
        this.list.add(#e);
        return this;
    }

    /**
     * Accepts WebSocket connections on `path` with open and close hooks
     * (spec §3). `onOpen` runs once the connection is in the registry and
     * before its first message; `onClose` runs exactly once with the close
     * code, whatever the cause, before the connection's components drop.
     * Both run inside the connection's `Connection` scope.
     */
    public WebSocketEndpoints json(String path, (Connection) -> void onOpen,
                                   (Connection, JsonBody) -> void onMessage,
                                   (Connection, int32) -> void onClose) {
        WebSocketEndpoint e = heap WebSocketEndpoint(path, onMessage);
        e.openH #= onOpen;
        e.hasOpen = true;
        e.closeH #= onClose;
        e.hasClose = true;
        this.list.add(#e);
        return this;
    }

    public int32 count() { return this.list.count(); }

    /** The identity of the path declared last, for a security rule on its upgrade route. */
    public RouteId last() { return this.list.get(this.list.count() - 1).id; }

    // Adds an upgrading GET route to `api` for every path.
    void install(Endpoints api, ConnectionRegistry registry) {
        int32 i = 0;
        while (i < this.list.count()) {
            this.installOne(api, this.list.get(i), registry);
            i = i + 1;
        }
        return;
    }

    void installOne(Endpoints api, WebSocketEndpoint e, ConnectionRegistry registry) {
        int32 bound = this.bound;
        int32 overflow = this.overflow;
        api.routeAs(e.id, (RequestView q, Response r) ->
            WebSocketEndpoints.upgrade(q, r, e, registry, bound, overflow));
        return;
    }

    static void upgrade(RequestView q, Response r, WebSocketEndpoint e, ConnectionRegistry registry,
                        int32 bound, int32 overflow) {
        Connection c = heap Connection(registry.nextId(), registry, e, bound, overflow);
        WsUpgrade.accept(q.request(), r.raw(), #c, false);
        return;
    }
}
