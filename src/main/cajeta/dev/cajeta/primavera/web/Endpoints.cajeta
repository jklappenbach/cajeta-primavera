package dev.cajeta.primavera.web;

import cajeta.collection.ArrayList;
import cajeta.lang.Slice;
import cajeta.lang.String;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.routing.Router;

/**
 * The typed endpoint surface (primavera-web spec §5.2): each registration
 * names a method, a route pattern, a body binding mode, and a handler whose
 * parameters are the bound values. The annotation form compiles down to
 * these calls; this surface stays public.
 */
public final class Endpoints {

    Router router;
    ArrayList<Endpoint> list;
    // The static mounts, which their routes' handlers borrow.
    ArrayList<StaticMount> mounts;

    public Endpoints() {
        this.router = heap Router();
        this.list = heap ArrayList<Endpoint>();
        this.mounts = heap ArrayList<StaticMount>();
        return;
    }

    void add(String method, String pattern, #Endpoint e) {
        e.id #= heap RouteId(method, pattern);
        this.addWith(method, pattern, #e);
        return;
    }

    void addWith(String method, String pattern, #Endpoint e) {
        this.router.route(method, pattern, (HttpRequest q, HttpResponse r) -> {
            return;
        });
        this.list.add(#e);
        return;
    }

    // A route whose identity was handed out before it was installed: a
    // WebSocket path's, minted when the path was declared. The path keeps
    // the identity and this endpoint borrows it; the server owns both.
    void routeAs(RouteId id, (RequestView, Response) -> void handler) {
        Endpoint e = heap Endpoint(BodyMode.NONE());
        e.plain #= handler;
        String method = "" + id.method();
        String pattern = "" + id.pattern();
        e.id #= id;
        this.addWith(method, pattern, #e);
        return;
    }

    /** An endpoint with no body binding. */
    public Endpoints route(String method, String pattern, (RequestView, Response) -> void handler) {
        Endpoint e = heap Endpoint(BodyMode.NONE());
        e.plain #= handler;
        this.add(method, pattern, #e);
        return this;
    }

    /** An endpoint whose body is a JSON object indexed in place. */
    public Endpoints json(String method, String pattern, (RequestView, JsonBody, Response) -> void handler) {
        Endpoint e = heap Endpoint(BodyMode.JSON());
        e.json #= handler;
        this.add(method, pattern, #e);
        return this;
    }

    /** An endpoint handed the body window, for a `view` over a fixed binary layout. */
    public Endpoints window(String method, String pattern, (RequestView, Slice<int8>, Response) -> void handler) {
        Endpoint e = heap Endpoint(BodyMode.VIEW());
        e.window #= handler;
        this.add(method, pattern, #e);
        return this;
    }

    /** An endpoint whose body decodes into a fresh owned `T`; the buffer is free once decoded. */
    public final Endpoints owned<T>(String method, String pattern, (RequestView, T, Response) -> void handler) {
        Endpoint e = heap Endpoint(BodyMode.OWNED());
        OwnedEndpoint<T> decoder = heap OwnedEndpoint<T>(handler);
        e.owned #= decoder;
        this.add(method, pattern, #e);
        return this;
    }

    /**
     * An endpoint whose body codec is negotiated (spec §7.1): `handler` is
     * usually a {@link CodecEndpoint}, which the server owns from here.
     */
    public Endpoints codec(String method, String pattern, #CodedHandler handler) {
        Endpoint e = heap Endpoint(BodyMode.CODEC());
        e.coded #= handler;
        this.add(method, pattern, #e);
        return this;
    }

    /** How many endpoints are registered. */
    /**
     * Serves the files under `dir` at `prefix` (primavera-live-sessions spec
     * §5): GET and HEAD resolve to a file under the directory, with a type by
     * extension; the prefix itself serves `index.html`; a missing file is
     * 404; a path that escapes the directory, lexically or through a symlink
     * that resolves outside it, is 403. Another method under the prefix
     * answers 405 unless a declared route takes it, and a declared route wins
     * over a file of the same path, since the router picks the most specific
     * match. The mount is one route: `last()` is its {@link RouteId}, so a
     * security rule addresses it like any other.
     */
    public Endpoints staticDir(String prefix, String dir) {
        StaticMount m = heap StaticMount(dir);
        this.mounts.add(#m);
        StaticMount mount = this.mounts.get(this.mounts.count() - 1);
        String base #= prefix.substring(0, prefix.byteLength());
        if (base.endsWith("/")) {
            base #= base.substring(0, base.byteLength() - 1);
        }
        String rest #= base + "/{path:**}";
        String exact #= base.byteLength() == 0 ? "/" : base.substring(0, base.byteLength());

        Endpoint first = heap Endpoint(BodyMode.NONE());
        first.plain #= (RequestView q, Response r) -> StaticMount.serve(mount, q, r);
        first.id #= heap RouteId("GET", rest);
        this.addWith("GET", rest, #first);
        RouteId id = this.list.get(this.list.count() - 1).id;
        this.addShared("HEAD", rest, id, mount);
        this.addShared("GET", exact, id, mount);
        this.addShared("HEAD", exact, id, mount);
        return this;
    }

    // One more route of a static mount, under the mount's identity, which
    // the first route owns and this one borrows.
    void addShared(String method, String pattern, RouteId id, StaticMount mount) {
        Endpoint e = heap Endpoint(BodyMode.NONE());
        e.plain #= (RequestView q, Response r) -> StaticMount.serve(mount, q, r);
        e.id #= id;
        this.addWith(method, pattern, #e);
        return;
    }

    public int32 count() { return this.list.count(); }

    /** The identity of the endpoint registered last, for a security rule. */
    public RouteId last() { return this.list.get(this.list.count() - 1).id; }

    /** The identity of endpoint `i`, in registration order, as {@link RouteMatch#index} names it. */
    public RouteId routeAt(int32 i) { return this.list.get(i).id; }

    Endpoint at(int32 i) { return this.list.get(i); }
}
