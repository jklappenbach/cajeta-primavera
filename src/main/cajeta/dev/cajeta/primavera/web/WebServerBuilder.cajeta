package dev.cajeta.primavera.web;

import cajeta.collection.ArrayList;
import cajeta.io.net.BufferPool;
import cajeta.lang.String;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.http.server.HttpServerBuilder;
import dev.cajeta.primavera.pipeline.BufferSource;
import dev.cajeta.primavera.pipeline.Pipeline;
import dev.cajeta.primavera.pipeline.Stage;

/**
 * Collects a web server's address, endpoints, leading stages, buffer size
 * (64 KiB unless set) and coding threshold. Building it registers every
 * {@link ContentCodingProvider} compiled into the program.
 */
public final class WebServerBuilder {

    String addr;
    int32 bytes;
    int32 codeAbove;
    Endpoints api;
    WebSocketEndpoints sockets;
    ArrayList<Stage> leading;
    Guard gate;
    int64 sweep;

    public WebServerBuilder() {
        this.addr = "127.0.0.1:0";
        this.bytes = 65536;
        this.codeAbove = 256;
        this.api = null;
        this.sockets = null;
        this.leading = heap ArrayList<Stage>();
        this.gate = null;
        this.sweep = 0;
        return;
    }

    /**
     * Sweep expired sessions every `millis` ms while serving, in place of a
     * quarter of the ambient store's idle TTL (spec §7.3). With no TTL and no
     * override the server does not sweep.
     */
    public WebServerBuilder sessionSweep(int64 millis) {
        this.sweep = millis;
        return this;
    }

    public WebServerBuilder bind(String addr) {
        this.addr #= addr.substring(0, addr.byteLength());
        return this;
    }

    /** The size of every connection and pipeline buffer (spec §10.2). */
    public WebServerBuilder bufferBytes(int32 n) {
        this.bytes = n;
        return this;
    }

    /**
     * Responses of at least `n` bytes are content-coded when the client
     * accepts a coding (spec §7.3); 256 unless set, 0 codes every body.
     */
    public WebServerBuilder compressAbove(int32 n) {
        this.codeAbove = n;
        return this;
    }

    public WebServerBuilder endpoints(#Endpoints e) {
        this.api #= e;
        return this;
    }

    /** WebSocket paths, each an upgrading GET route on the HTTP pipeline (spec §6). */
    public WebServerBuilder websockets(#WebSocketEndpoints ws) {
        this.sockets #= ws;
        return this;
    }

    /** A stage that runs ahead of the standard ones, in call order. */
    public WebServerBuilder stage(#Stage s) {
        this.leading.add(#s);
        return this;
    }

    /**
     * Secures every route with `g` (spec §8). The guard sees every route,
     * WebSocket paths included, before the server binds, and may refuse to
     * start.
     */
    public WebServerBuilder guard(#Guard g) {
        this.gate #= g;
        return this;
    }

    /** Builds the pipeline, checks it, and binds the server. */
    public #WebServer build() {
        WebServer ws = heap WebServer();
        ws.sweepOverride = this.sweep;
        if (this.api == null) {
            this.api = heap Endpoints();
        }
        if (this.sockets != null) {
            ws.sockets #= this.sockets;
            this.sockets = null;
            ws.sockets.install(this.api, ws.registry);
        }
        ws.endpoints #= this.api;
        this.api = null;
        ws.source = heap BufferSource(this.bytes, 16);
        Pipeline p = heap Pipeline(ws.source);
        while (this.leading.count() > 0) {
            Stage s #= this.leading.removeAt(0);
            p.add(#s);
        }
        ContentCodingProviders.install();
        if (this.gate != null) {
            ws.guard #= this.gate;
            this.gate = null;
            HttpPipeline.addGuarded(p, ws.endpoints, this.codeAbove, ws.guard);
        } else {
            HttpPipeline.addStandard(p, ws.endpoints, this.codeAbove);
        }
        p.build();
        ws.pipeline #= p;
        Dispatch d = heap Dispatch(ws.pipeline, ws.source);
        HttpServerBuilder hb #= HttpServer.builder();
        hb.bind(this.addr);
        hb.bufferPool(heap BufferPool(this.bytes, 64));
        hb.handler((HttpRequest q, HttpResponse r) -> #d.run(q, r));
        ws.server #= hb.build();
        return #ws;
    }
}
