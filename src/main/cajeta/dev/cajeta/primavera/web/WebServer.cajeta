package dev.cajeta.primavera.web;

import cajeta.concurrent.Channel;
import cajeta.io.net.SocketAddress;
import cajeta.lang.String;
import cajeta.time.Duration;
import dev.cajeta.http.HttpRequest;
import dev.cajeta.http.HttpResponse;
import dev.cajeta.http.server.HttpServer;
import dev.cajeta.primavera.context.Requests;
import dev.cajeta.primavera.pipeline.Buffer;
import dev.cajeta.primavera.pipeline.BufferSource;
import dev.cajeta.primavera.pipeline.Pipeline;
import dev.cajeta.primavera.pipeline.RequestContext;

/**
 * Endpoints served over `cajeta-http` (primavera-web spec §5, §7.8). Each
 * request runs the pipeline as one `Request` scope ({@link Requests}), over the body the
 * transport framed into its pooled input buffer and lent for the request.
 */
public final class WebServer {

    HttpServer server;
    Pipeline pipeline;
    BufferSource source;
    Endpoints endpoints;
    // The WebSocket paths: the routes and every connection borrow them.
    WebSocketEndpoints sockets;
    ConnectionRegistry registry;
    // The guard the pipeline's security stages borrow, or null.
    Guard guard;

    WebServer() {
        this.server = null;
        this.pipeline = null;
        this.source = null;
        this.endpoints = null;
        this.sockets = null;
        this.registry = heap ConnectionRegistry();
        this.guard = null;
        return;
    }

    /** A server on `addr` over `api` with the standard pipeline and 64 KiB buffers. */
    public static #WebServer bind(String addr, #Endpoints api) {
        WebServerBuilder b #= WebServer.builder();
        b.bind(addr);
        b.endpoints(#api);
        return b.build();
    }

    /** A builder: an address, endpoints, optional leading stages, and a buffer size. */
    public static #WebServerBuilder builder() {
        return heap WebServerBuilder();
    }

    static void dispatch(Pipeline p, BufferSource s, HttpRequest q, HttpResponse r) {
        Requests.run(() -> WebServer.run(p, s, q, r));
        return;
    }

    static void run(Pipeline p, BufferSource s, HttpRequest q, HttpResponse r) {
        RequestContext ctx = heap RequestContext(s);
        ctx.bindHttp(q, r);
        Buffer input #= s.lend(q.bodyStore(), q.bodyOffset(), q.bodyLength());
        try {
            p.run(#input, ctx);
        } finally {
            ctx.close();
        }
        return;
    }

    /**
     * Serves until {@link #shutdown}. Each WebSocket connection's writer
     * fiber runs inside this call, so it returns once they have all ended.
     */
    public void serve() {
        ConnectionRegistry r = this.registry;
        scope {
            spawn writers(r);
            this.server.serve();
        }
        return;
    }

    // Spawns a writer fiber for each connection the registry opens, until
    // the registry shuts down; returns when they have all ended.
    static async int32 writers(ConnectionRegistry registry) {
        scope {
            boolean going = true;
            while (going) {
                Optional<Connection> o = registry.opened.receive();
                if (o.isPresent()) {
                    spawn writer(o.get());
                } else {
                    going = false;
                }
            }
        }
        return 1;
    }

    static async int32 writer(Connection c) {
        c.writeLoop();
        return 1;
    }

    /**
     * Stops accepting, closes every WebSocket connection with 1001, and waits
     * up to `deadline` for requests in flight.
     */
    public boolean shutdown(Duration deadline) {
        this.registry.shutdown();
        return this.server.shutdown(deadline);
    }

    /** The open WebSocket connections. */
    public ConnectionRegistry connections() { return this.registry; }

    /** The bound address, with the port the system chose for port 0. */
    public #SocketAddress localAddress() {
        return this.server.localAddress();
    }

    /** The bound port. */
    public int32 port() {
        return this.server.server.listener.boundPort();
    }

    /** Fresh connection buffers the transport's pool has made. */
    public int32 bufferAllocations() {
        return this.server.bufferAllocations();
    }

    /**
     * Connection buffers returned and waiting for reuse. A closed connection
     * gives back both of its buffers, so a caller can wait for that rather
     * than race the transport's teardown.
     */
    public int32 idleBuffers() {
        return this.server.idleBuffers();
    }

    /** The pipeline's own buffer source, for stages that take a buffer. */
    public BufferSource buffers() { return this.source; }

    public Pipeline pipeline() { return this.pipeline; }
}
