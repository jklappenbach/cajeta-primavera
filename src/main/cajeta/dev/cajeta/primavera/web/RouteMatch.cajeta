package dev.cajeta.primavera.web;

import cajeta.aot.Component;

/** The result of routing, provided into the request: which endpoint matched. */
@Component(scope = "Request")
public final class RouteMatch {

    int32 endpointIndex;

    public RouteMatch(int32 index) {
        this.endpointIndex = index;
        return;
    }

    /** The endpoint's registration order in its {@link Endpoints}. */
    public int32 index() { return this.endpointIndex; }
}
