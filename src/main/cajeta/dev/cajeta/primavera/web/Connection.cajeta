package dev.cajeta.primavera.web;

import cajeta.aot.Scope;
import cajeta.concurrent.Channel;
import cajeta.concurrent.Fiber;
import cajeta.concurrent.Lock;
import cajeta.concurrent.LockGuard;
import cajeta.lang.String;
import cajeta.time.Duration;
import dev.cajeta.logging.Level;
import dev.cajeta.logging.Logged;
import dev.cajeta.logging.LogRecord;
import dev.cajeta.http.status.BadRequestException;
import dev.cajeta.http.ws.MessageTooLargeException;
import dev.cajeta.http.ws.WebSocketConnection;
import dev.cajeta.http.ws.WebSocketHandler;
import dev.cajeta.http.ws.WsMessage;

/**
 * One open WebSocket connection, and the anchor of the `Connection` scope
 * (component-scopes spec §10.3): a `@Component(scope = "Connection")` lives
 * from open to close. Each message runs in a `Message` scope inside it
 * (§10.4), indexed as JSON over the connection's buffer and handed to its
 * path's handler (primavera-web spec §6.2).
 *
 * A handler that throws closes the connection (spec §7.12): a body that is
 * not a JSON object with 1007, an oversized message with 1009, a
 * {@link CloseException} with its code, anything else with 1011. The peer
 * gets the code and no detail.
 *
 * Sends are queued in a ring of at most `bound` bytes ({@link SendRing}:
 * each message counts its payload plus 4) and written by the connection's
 * writer fiber. A send that finds the queue full aborts the connection with
 * the overflow code (spec §6.5).
 */
@Scope("Connection")
@Logged
public class Connection implements WebSocketHandler {
    int64 connId;
    ConnectionRegistry registry;
    WebSocketEndpoint endpoint;
    WebSocketConnection ws;
    JsonBody body;

    Lock gate;
    SendRing ring;
    int32 bound;
    int32 overflow;
    boolean signalled;
    boolean closing;
    boolean writing;
    // The open hook threw: the connection is closing and no message
    // handler runs on it.
    boolean refused;
    // A writer fiber was handed this connection and will run writeLoop on
    // it, so onClose must wait for that to end before the connection drops.
    boolean dispatched;
    Channel<int32> wake;
    Channel<int32> done;

    // The registry and endpoint belong to the server and outlive the
    // connection, so they are kept as borrows.
    Connection(int64 id, ^ConnectionRegistry registry, ^WebSocketEndpoint endpoint,
               int32 bound, int32 overflow) {
        this.connId = id;
        this.registry = registry;
        this.endpoint = endpoint;
        this.ws = null;
        this.body = heap JsonBody();
        this.gate = heap Lock();
        this.ring = heap SendRing(bound);
        this.bound = bound;
        this.overflow = overflow;
        this.signalled = false;
        this.closing = false;
        this.writing = false;
        this.refused = false;
        this.dispatched = false;
        this.wake = heap Channel<int32>(1);
        this.done = heap Channel<int32>(1);
        return;
    }

    /** The connection's id in its server's {@link ConnectionRegistry}. */
    public int64 id() { return this.connId; }

    /** Queues `text` for the peer. */
    public void send(String text) {
        this.enqueue(text);
        return;
    }

    /** Closes the connection with `code` and no reason. */
    public void close(int32 code) {
        if (this.ws != null) {
            String none = "";
            try {
                this.ws.close(code, none);
            } catch (Exception e) {
            }
        }
        return;
    }

    public void onConnect(WebSocketConnection conn) {
        this.ws #= conn;
        this.dispatched = this.registry.add(this);
        if (this.endpoint.hasOpen) {
            try {
                Connection.callOpen(this.endpoint.openH, this);
            } catch (CloseException e) {
                this.refused = true;
                this.close(e.code);
            } catch (Exception e) {
                this.refused = true;
                this.close(1011);
            }
        }
        return;
    }

    static void callOpen((Connection) -> void h, Connection c) {
        h(c);
    }

    static void callClose((Connection, int32) -> void h, Connection c, int32 code) {
        h(c, code);
    }

    // Aborts with `code` (server shutdown, §3.2): the receive loop ends and
    // the close hook sees `code`. No close frame goes first: on cajeta-http
    // 0.9.0 a server-side close followed by abort leaves `next()` parked and
    // the close hook never runs, so the peer sees an abnormal closure (1006).
    void abortWith(int32 code) {
        if (this.ws != null) {
            try {
                this.ws.abort(code);
            } catch (Exception e) {
            }
        }
        return;
    }

    @Scope(value = "Message", within = "Connection")
    public void onMessage(WebSocketConnection conn, WsMessage message) {
        if (this.refused) {
            return;
        }
        try {
            this.body.bind(message.bytes(), 0, message.length());
            (Connection, JsonBody) -> void h = this.endpoint.json;
            h(this, this.body);
        } catch (CloseException e) {
            this.close(e.code);
        } catch (BadRequestException e) {
            this.close(1007);
        } catch (MessageTooLargeException e) {
            this.close(1009);
        } catch (Exception e) {
            this.close(1011);
        }
        return;
    }

    // Out of the registry first, so a send from the close hook reports not
    // open (§3.3); then the writer is stopped, aborting the socket only if a
    // writer is stuck on a full kernel buffer; then the close hook runs with
    // the code, before the Connection components drop (§3.2).
    public void onClose(WebSocketConnection conn, int32 code) {
        this.registry.closed(this, code);
        boolean wait = false;
        {
            LockGuard g #= this.gate.acquire();
            this.closing = true;
            // Wait on any writer that was dispatched, started or not: one
            // still queued would otherwise run writeLoop on a freed
            // connection (a null vtable call in WebServer.writer, D-15).
            wait = this.writing || this.dispatched;
        }
        this.wake.close();
        if (wait) {
            // The writer ends on its own once the wake channel closes. Abort
            // only a writer still inside a send after 200 ms (stuck on a full
            // kernel buffer): aborting under a send in progress faulted.
            int32 polls = 0;
            boolean ended = false;
            while (!ended && polls < 40) {
                ended = this.done.tryReceive().isPresent();
                if (!ended) {
                    Fiber.sleep(Duration.ofMillis(5));
                    polls = polls + 1;
                }
            }
            if (!ended) {
                if (this.ws != null) {
                    try {
                        this.ws.abort(code);
                    } catch (Exception e) {
                    }
                }
                this.done.receive();
            }
        }
        if (this.endpoint.hasClose) {
            try {
                Connection.callClose(this.endpoint.closeH, this, code);
            } catch (Exception e) {
                LogRecord r #= log.event(Level.WARN, "WebSocket close handler threw");
                r.i64("connection", this.connId);
                r.i64("code", code);
                log.emit(#r);
            }
        }
        this.ws = null;
        return;
    }

    // Copies `text` into the next slot and wakes the writer. Never parks: a
    // full queue aborts the connection instead. Returns whether it queued.
    boolean enqueue(String text) {
        boolean abort = false;
        boolean queuedIt = false;
        {
            LockGuard g #= this.gate.acquire();
            if (this.closing) {
                queuedIt = false;
            } else if (!this.ring.push(text)) {
                // Past the bound, or one message larger than it (spec §4.2.1,
                // §4.3): refused, and the connection closes.
                this.closing = true;
                abort = true;
            } else {
                this.registry.notePeak(this.ring.queuedBytes());
                queuedIt = true;
                if (!this.signalled) {
                    this.signalled = true;
                    this.wake.send(1);
                }
            }
        }
        if (abort) {
            this.ws.abort(this.overflow);
            this.wake.close();
        }
        return queuedIt;
    }

    // The writer fiber's body: sends what is queued, oldest first, until
    // the connection closes.
    void writeLoop() {
        boolean going = true;
        {
            LockGuard g #= this.gate.acquire();
            if (this.closing) {
                going = false;
            } else {
                this.writing = true;
            }
        }
        while (going) {
            if (!this.wake.receive().isPresent()) {
                going = false;
            } else {
                {
                    LockGuard g #= this.gate.acquire();
                    this.signalled = false;
                }
                going = this.drain();
            }
        }
        this.done.send(1);
        return;
    }

    // Sends until the queue is empty; false once a send fails.
    boolean drain() {
        boolean more = true;
        boolean ok = true;
        while (more && ok) {
            int32 off = -1;
            int32 len = 0;
            {
                LockGuard g #= this.gate.acquire();
                off = this.ring.peekOffset();
                len = this.ring.peekLength();
            }
            if (off < 0) {
                more = false;
            } else {
                // The record stays put until pop, so it is sent in place,
                // outside the gate.
                try {
                    this.ws.sendText(this.ring.bytes(), off, len);
                } catch (Exception e) {
                    ok = false;
                }
                if (ok) {
                    LockGuard g #= this.gate.acquire();
                    this.ring.pop();
                }
            }
        }
        return ok;
    }
}
