package dev.cajeta.primavera.test;

import dev.cajeta.primavera.context.Requests;
import dev.cajeta.primavera.context.SessionScope;

/**
 * primavera's test facade: harnesses for exercising `Request`- and
 * `Session`-scoped code from tests. Deliberately free of any cajeta-unit
 * dependency: assertions are the test framework's job; this class only
 * stands scopes up and tears them down. Pair it with cajeta-unit's
 * `TestRunner`/`Assert`/mocks (and `TestContext` for `@Inject` overrides in
 * `--profile=test` builds).
 *
 * Mocking a scoped component needs no special machinery: provide the mock
 * BEFORE the code under test injects it, and that injection gets the mock.
 *
 * ```cajeta
 * PrimaveraTest.request(() -> {
 *     Gateway mock = heap MockGateway();
 *     Components.provide(#mock);           // the request's Gateway is the mock
 *     handler.handle(request);
 * });
 * ```
 *
 * Call `reset()` between tests: the session store is process-wide state and
 * would otherwise bleed sessions and TTL config across tests.
 */
public class PrimaveraTest {

    /** Run `body` as one request; its `Request` components are freed at its end. */
    public static void request(() -> void body) {
        Requests.run(body);
    }

    /**
     * Create a FRESH session under `id` (displacing, and dropping, any prior
     * session with that id) and run `body` attached to it. The canonical
     * per-test entry: the test always starts from a clean session.
     */
    public static void freshSession(String id, () -> void body) {
        SessionScope.create(id);
        SessionScope.attach(id, body);
    }

    /**
     * Attach to an EXISTING session and run `body`, a later request of the
     * same client. Pair with `freshSession` to test cross-request
     * persistence; attaching to an id that was never created runs `body`
     * sessionless (isActive() false), which is itself a testable state.
     */
    public static void resumeSession(String id, () -> void body) {
        SessionScope.attach(id, body);
    }

    /**
     * Restore session state to a blank slate: drop every session (their
     * components free) and disable both TTLs. Call between tests: the store
     * is process-wide and never resets itself.
     */
    public static void reset() {
        SessionScope.invalidateAll();
        SessionScope.configure(0, 0);
        // Restore the system clock so a prior test's ManualTimeSource (which
        // the store only borrowed) is no longer referenced before it drops.
        SessionScope.useSystemClock();
    }
}
