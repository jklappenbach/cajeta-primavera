package dev.cajeta.primavera.test;

/**
 * Destructor-counting probe for lifecycle tests: hold one where the code
 * under test should free it, then assert `drops` afterward to prove it was
 * freed (a leak test), or that it was NOT freed early. Reset the counter at
 * the start of each test.
 *
 * ```cajeta
 * TrackedBean.resetDrops();
 * PrimaveraTest.request(() -> {
 *     Holder h = Holder.__cajeta_inject();      // a Request component
 *     h.bean #= heap TrackedBean(1);
 * });
 * Assert.that(TrackedBean.drops).isEqualTo(1);   // the request freed it
 * ```
 */
public class TrackedBean {
    public static int32 drops;

    public int32 tag;

    public TrackedBean(int32 tag) {
        this.tag = tag;
    }

    public ~TrackedBean() {
        TrackedBean.drops = TrackedBean.drops + 1;
    }

    public static void resetDrops() {
        TrackedBean.drops = 0;
    }
}
