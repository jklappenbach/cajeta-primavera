package dev.cajeta.primavera.pipeline;

import cajeta.error.RecoverableException;
import cajeta.lang.String;

/** A pipeline that cannot be built: a chain whose kinds do not meet (spec §7.9). */
public class PipelineException extends RecoverableException {

    public PipelineException(#String message) {
        this.message #= message;
        this.cause = 0;
    }
}
