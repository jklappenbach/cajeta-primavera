package dev.cajeta.primavera.security;

import cajeta.lang.String;
import dev.cajeta.primavera.pipeline.Buffer;
import dev.cajeta.primavera.pipeline.Kind;
import dev.cajeta.primavera.pipeline.RequestContext;
import dev.cajeta.primavera.pipeline.Stage;

/** Verifies the bearer token and provides the request's {@link SecurityContext}, ROUTED to AUTHENTICATED. */
final class AuthenticationStage implements Stage {

    WebSecurity sec;

    AuthenticationStage(WebSecurity sec) {
        this.sec #= sec;
        return;
    }

    public #String name() { String s = "authentication"; return #s; }
    public int32 consumes() { return Kind.ROUTED(); }
    public int32 produces() { return Kind.AUTHENTICATED(); }

    public Buffer inbound(Buffer buffer, RequestContext ctx) {
        this.sec.authenticate(ctx);
        return #= buffer;
    }

    public Buffer outbound(Buffer buffer, RequestContext ctx) { return #= buffer; }
}
