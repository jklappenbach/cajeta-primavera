package dev.cajeta.primavera.security;

import cajeta.lang.String;
import dev.cajeta.primavera.pipeline.Buffer;
import dev.cajeta.primavera.pipeline.Kind;
import dev.cajeta.primavera.pipeline.RequestContext;
import dev.cajeta.primavera.pipeline.Stage;

/** Applies the matched route's {@link Policy}, AUTHENTICATED to AUTHORIZED; 401 or 403 when it refuses. */
final class AuthorizationStage implements Stage {

    WebSecurity sec;

    AuthorizationStage(WebSecurity sec) {
        this.sec #= sec;
        return;
    }

    public #String name() { String s = "authorization"; return #s; }
    public int32 consumes() { return Kind.AUTHENTICATED(); }
    public int32 produces() { return Kind.AUTHORIZED(); }

    public Buffer inbound(Buffer buffer, RequestContext ctx) {
        this.sec.authorize(ctx);
        return #= buffer;
    }

    public Buffer outbound(Buffer buffer, RequestContext ctx) { return #= buffer; }
}
