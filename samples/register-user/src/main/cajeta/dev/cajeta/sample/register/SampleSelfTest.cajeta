package dev.cajeta.sample.register;

import cajeta.io.net.SocketAddress;
import cajeta.io.net.TcpStream;
import cajeta.lang.Slice;
import cajeta.lang.String;
import cajeta.time.Duration;
import dev.cajeta.codec.protobuf.Protobuf;
import dev.cajeta.http.Bytes;
import dev.cajeta.http.coding.ContentCodings;
import dev.cajeta.cloud.identity.MemoryUserPool;
import dev.cajeta.http.ClientRequest;
import dev.cajeta.http.ClientResponse;
import dev.cajeta.http.client.HttpClient;
import cajeta.concurrent.Fiber;
import dev.cajeta.http.ws.WebSocket;
import dev.cajeta.http.ws.WsMessage;
import cajeta.codec.Base32;
import cajeta.collection.ArrayList;
import cajeta.hash.Totp;
import cajeta.process.Command;
import cajeta.process.ProcessResult;
import cajeta.time.Clock;
import dev.cajeta.cloud.identity.IdentityCapability;
import dev.cajeta.cloud.identity.IdentitySelector;
import dev.cajeta.logging.CapturingAppender;
import dev.cajeta.logging.JsonlEncoder;
import dev.cajeta.logging.Level;
import dev.cajeta.logging.Logger;
import dev.cajeta.primavera.security.SecurityException;
import dev.cajeta.primavera.web.JsonBody;
import dev.cajeta.primavera.web.WebServer;

/**
 * The sample's self-test (primavera-web plan 2.1.1, 2.1.2, 2.1.4, 5.1,
 * 6.1): the registration contract end to end over one keep-alive
 * connection, each codec and coding pairing of spec §7.7, the security flow
 * from registration to logout, flat buffer pools across N requests, and an
 * equal live count across a run. Its argument is the production build of
 * the sample, which must refuse to start with no identity provider named.
 * Exits 0 when every check passes.
 */
public final class SampleSelfTest {

    static int32 failures;
    static int32 checks;

    static void check(boolean ok, String label) {
        SampleSelfTest.checks = SampleSelfTest.checks + 1;
        if (!ok) {
            SampleSelfTest.failures = SampleSelfTest.failures + 1;
            System.stdout.println("  FAIL " + label);
        }
        return;
    }

    static async int32 serve(WebServer web) {
        web.serve();
        return 1;
    }

    /** The string value of top-level field `name` in a flat JSON object, or "". */
    static #String field(String json, String name) {
        String key = "\"" + name + "\":\"";
        int32 at = json.indexOf(key);
        if (at < 0) {
            return "";
        }
        int32 from = at + key.byteLength();
        int32 to = from;
        while (to < json.byteLength() && json.byteAt(to) != (int8) 34) {
            to = to + 1;
        }
        return json.substring(from, to);
    }

    static int32 post(HttpClient client, ClientResponse resp, String url, String body) {
        ClientRequest req #= ClientRequest.post(url);
        req.setHeader("Content-Type", "application/json");
        req.body(body);
        client.send(req, resp);
        return resp.status();
    }

    static int32 get(HttpClient client, ClientResponse resp, String url) {
        ClientRequest req = heap ClientRequest(url);
        client.send(req, resp);
        return resp.status();
    }

    static int32 getAs(HttpClient client, ClientResponse resp, String url, String token) {
        ClientRequest req = heap ClientRequest(url);
        req.setHeader("Authorization", "Bearer " + token);
        client.send(req, resp);
        return resp.status();
    }

    static int32 postAs(HttpClient client, ClientResponse resp, String url, String token, String body) {
        ClientRequest req #= ClientRequest.post(url);
        req.setHeader("Content-Type", "application/json");
        req.setHeader("Authorization", "Bearer " + token);
        req.body(body);
        client.send(req, resp);
        return resp.status();
    }

    // The six-digit code for `secret` (Base32) at now plus `ahead` seconds.
    static #String totp(String secret, int64 ahead) {
        int8[] key #= Base32.decode(secret);
        int64 now = Clock.millisTime() / 1000L + ahead;
        return Totp.format(Totp.code(key, key.count(), now, 30, 6), 6);
    }

    // Keeps a secret the flow handled, for the captured-output check
    // (6.1.7). The list is the run's own local: a static reassigned per run
    // keeps the old list alive (measured 2026-10-13), which the live-count
    // check then reads as a leak.
    static void secret(ArrayList<String> secrets, String s) {
        String kept = "" + s;
        secrets.add(#kept);
        return;
    }

    // Signs `username` in through MFA setup and answers the tokens' JSON;
    // `secretOut` gets the TOTP secret. Empty on any failure.
    static #String firstLogin(HttpClient client, ClientResponse resp, String base, String username,
                              ArrayList<String> secretOut, ArrayList<String> secrets) {
        int32 s = SampleSelfTest.post(client, resp, base + "/login",
            "{\"username\":\"" + username + "\",\"password\":\"correct horse\"}");
        String first #= resp.bodyString();
        String kind #= SampleSelfTest.field(first, "challenge");
        SampleSelfTest.check(s == 200 && kind.equals("MFA_SETUP"),
            "login with TOTP required and none enrolled answers MFA_SETUP (" + s + " " + first + ")");
        String h1 #= SampleSelfTest.field(first, "session");
        s = SampleSelfTest.post(client, resp, base + "/login/challenge", "{\"session\":\"" + h1 + "\"}");
        String setup #= resp.bodyString();
        String secret #= SampleSelfTest.field(setup, "secret");
        String h2 #= SampleSelfTest.field(setup, "session");
        SampleSelfTest.check(s == 200 && secret.byteLength() >= 16 && h2.byteLength() > 0 && !h2.equals(h1),
            "the challenge endpoint enrols TOTP under a fresh handle (" + s + ")");
        SampleSelfTest.secret(secrets, secret);
        String code #= SampleSelfTest.totp(secret, 0L);
        SampleSelfTest.secret(secrets, code);
        s = SampleSelfTest.post(client, resp, base + "/login/challenge",
            "{\"session\":\"" + h2 + "\",\"code\":\"" + code + "\"}");
        String tokens #= resp.bodyString();
        SampleSelfTest.check(s == 200 && SampleSelfTest.field(tokens, "access_token").byteLength() > 0,
            "a TOTP code completes the setup with tokens (" + s + ")");
        secretOut.add(#secret);
        return #tokens;
    }

    // Spec §8 and plan 6.1.1 to 6.1.3, 6.1.7 over the sample's endpoints.
    static void security(HttpClient client, ClientResponse resp, String base, MemoryUserPool pool, String adaId,
                         ArrayList<String> secrets) {
        int32 s = SampleSelfTest.get(client, resp, base + "/users/me");
        String anon #= resp.bodyString();
        SampleSelfTest.check(s == 401, "GET /users/me without a token answers 401 (got " + s + ")");

        s = SampleSelfTest.post(client, resp, base + "/login", "{\"username\":\"ada\",\"password\":\"wrong horse\"}");
        String wrong #= resp.bodyString();
        SampleSelfTest.secret(secrets, "wrong horse");
        int32 s2 = SampleSelfTest.post(client, resp, base + "/login", "{\"username\":\"nobody\",\"password\":\"correct horse\"}");
        String unknown #= resp.bodyString();
        SampleSelfTest.check(s == 401 && s2 == 401 && wrong.equals(unknown),
            "a wrong password and an unknown user answer the same 401 (" + s + " " + s2 + ")");

        ArrayList<String> adaSecret = heap ArrayList<String>();
        String tokens #= SampleSelfTest.firstLogin(client, resp, base, "ada", adaSecret, secrets);
        String access #= SampleSelfTest.field(tokens, "access_token");
        String refresh #= SampleSelfTest.field(tokens, "refresh_token");
        SampleSelfTest.secret(secrets, access);
        SampleSelfTest.secret(secrets, refresh);
        SampleSelfTest.secret(secrets, SampleSelfTest.field(tokens, "id_token"));

        s = SampleSelfTest.getAs(client, resp, base + "/users/me", access);
        String me #= resp.bodyString();
        SampleSelfTest.check(s == 200 && me.indexOf("\"id\":\"" + adaId + "\"") >= 0 && me.indexOf("\"username\":\"ada\"") >= 0,
            "the access token calls /users/me as the application's id (" + s + " " + me + ")");

        s = SampleSelfTest.post(client, resp, base + "/token/refresh", "{\"refresh_token\":\"" + refresh + "\"}");
        String renewed #= resp.bodyString();
        String access2 #= SampleSelfTest.field(renewed, "access_token");
        SampleSelfTest.secret(secrets, access2);
        SampleSelfTest.check(s == 200 && access2.byteLength() > 0, "refresh answers a new access token (" + s + ")");
        s = SampleSelfTest.getAs(client, resp, base + "/users/me", access2);
        SampleSelfTest.check(s == 200, "the refreshed token calls /users/me (got " + s + ")");

        s = SampleSelfTest.postAs(client, resp, base + "/logout", access2, "{\"refresh_token\":\"" + refresh + "\"}");
        SampleSelfTest.check(s == 204, "logout answers 204 (got " + s + ")");
        s = SampleSelfTest.post(client, resp, base + "/token/refresh", "{\"refresh_token\":\"" + refresh + "\"}");
        SampleSelfTest.check(s == 401, "logout revoked the refresh token (got " + s + ")");

        // The second sign-in is challenged for the enrolled TOTP. The code is
        // the next step's, since this step's was spent on the setup.
        s = SampleSelfTest.post(client, resp, base + "/login", "{\"username\":\"ada\",\"password\":\"correct horse\"}");
        String again #= resp.bodyString();
        String kind #= SampleSelfTest.field(again, "challenge");
        String h3 #= SampleSelfTest.field(again, "session");
        SampleSelfTest.check(s == 200 && kind.equals("TOTP"), "login answers challenge-required TOTP (" + s + " " + again + ")");
        String next #= SampleSelfTest.totp(adaSecret.get(0), 30L);
        SampleSelfTest.secret(secrets, next);
        s = SampleSelfTest.post(client, resp, base + "/login/challenge",
            "{\"session\":\"" + h3 + "\",\"code\":\"" + next + "\"}");
        String done #= resp.bodyString();
        String access3 #= SampleSelfTest.field(done, "access_token");
        SampleSelfTest.secret(secrets, access3);
        SampleSelfTest.secret(secrets, SampleSelfTest.field(done, "refresh_token"));
        SampleSelfTest.check(s == 200 && access3.byteLength() > 0, "the challenge endpoint completes the TOTP challenge (" + s + ")");
        s = SampleSelfTest.post(client, resp, base + "/login/challenge",
            "{\"session\":\"" + h3 + "\",\"code\":\"" + next + "\"}");
        SampleSelfTest.check(s == 401, "a used challenge handle answers 401 (got " + s + ")");

        // 403: a signed-in user whose groups map to no role.
        s = SampleSelfTest.post(client, resp, base + "/users", "{\"username\":\"mallory\",\"password\":\"correct horse\"}");
        String subject #= SampleSelfTest.subjectOf(pool, "mallory");
        String confirmCode #= pool.hooks().lastConfirmationCode(subject);
        SampleSelfTest.secret(secrets, confirmCode);
        pool.confirm("mallory", confirmCode);
        pool.removeFromGroup(subject, "members");
        ArrayList<String> malSecret = heap ArrayList<String>();
        String malTokens #= SampleSelfTest.firstLogin(client, resp, base, "mallory", malSecret, secrets);
        String malAccess #= SampleSelfTest.field(malTokens, "access_token");
        SampleSelfTest.secret(secrets, malAccess);
        SampleSelfTest.secret(secrets, SampleSelfTest.field(malTokens, "refresh_token"));
        s = SampleSelfTest.getAs(client, resp, base + "/users/me", malAccess);
        String forbidden #= resp.bodyString();
        SampleSelfTest.check(s == 403, "a token whose groups map to no permitted role answers 403 (got " + s + ")");
        SampleSelfTest.check(forbidden.indexOf("members") < 0 && forbidden.indexOf("user") < 0,
            "the 403 does not say which role was missing");
        return;
    }

    // Plan 6.1.7: no password, code or raw token in what the sample logged.
    static void noSecretsIn(CapturingAppender sink, ArrayList<String> secrets) {
        int32 leaks = 0;
        int32 i = 0;
        while (i < sink.count()) {
            int32 j = 0;
            while (j < secrets.count()) {
                String needle = secrets.get(j);
                if (needle.byteLength() >= 6 && sink.get(i).indexOf(needle) >= 0) {
                    System.stdout.println("  a log line carries a secret: " + sink.get(i));
                    leaks = leaks + 1;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        SampleSelfTest.check(sink.count() > 0, "the security log captured the refusals (" + sink.count() + " lines)");
        SampleSelfTest.check(leaks == 0, "no password, code or raw token in the captured log (" + leaks + ")");
        return;
    }

    // One request over a fresh socket, `Connection: close`; the whole response.
    // The client decodes codings itself, so a coded response is read here.
    static #String raw(int32 port, String head, int8[] body, int32 bodyLen) {
        TcpStream sock #= TcpStream.connectAsync(SocketAddress.parse("127.0.0.1:" + port));
        String req = head + "Host: t\r\nConnection: close\r\nContent-Length: " + bodyLen + "\r\n\r\n";
        int8[] hb #= req.toBytes();
        sock.writeAllAsync(hb, (int64) 0, (int64) req.byteLength());
        if (bodyLen > 0) {
            sock.writeAllAsync(body, (int64) 0, (int64) bodyLen);
        }
        int8[] buf = heap int8[16384];
        int32 n = 0;
        int64 got = sock.readAsync(buf, (int64) 0, (int64) 16384);
        while (got > (int64) 0) {
            n = n + (int32) got;
            got = sock.readAsync(buf, (int64) n, (int64) (16384 - n));
        }
        sock.close();
        return Bytes.toString(buf[0:n]);
    }

    static boolean hasHeader(String response, String line) {
        return response.indexOf(line) >= 0 || response.indexOf(line.toLowerCase()) >= 0;
    }

    static int32 send(HttpClient client, ClientResponse resp, String url, String contentType, String accept,
                      String coding, int8[] body, int32 len) {
        ClientRequest req #= ClientRequest.post(url);
        req.setHeader("Content-Type", contentType);
        if (accept != null) {
            req.setHeader("Accept", accept);
        }
        if (coding != null) {
            req.setHeader("Content-Encoding", coding);
        }
        req.body(body, len);
        client.send(req, resp);
        return resp.status();
    }

    // Spec §7.7 and plan 5.1: every codec and coding pairing on POST /users.
    static void pairings(HttpClient client, ClientResponse resp, String base, int32 port) {
        String url = base + "/users";
        String pb = "application/x-protobuf";
        Signup su = heap Signup();
        su.username = "proto";
        su.password = "correct horse";
        int8[] wire #= Protobuf.toBytes<Signup>(su);

        int32 s = SampleSelfTest.send(client, resp, url, pb, pb, null, wire, (int32) wire.count());
        SampleSelfTest.check(s == 201, "a protobuf registration answers 201 (got " + s + ")");
        Slice<int8> got = resp.body();
        int8[] back #= Bytes.copyOf(got);
        Account acct #= Protobuf.parse<Account>(back, back.count());
        SampleSelfTest.check(acct.username != null && acct.username.equals("proto") && acct.id != null,
            "Accept: protobuf answers a protobuf Account");
        SampleSelfTest.check(SampleSelfTest.hasHeader(resp.headerString("Content-Type"), pb),
            "the protobuf answer says so in Content-Type");

        su.username = "proto2";
        int8[] wire2 #= Protobuf.toBytes<Signup>(su);
        s = SampleSelfTest.send(client, resp, url, pb, "application/json", null, wire2, (int32) wire2.count());
        String asJson #= resp.bodyString();
        SampleSelfTest.check(s == 201 && asJson.indexOf("\"username\":\"proto2\"") >= 0,
            "a protobuf request answers JSON when JSON is accepted");

        String json = "{\"username\":\"jsonpb\",\"password\":\"correct horse\"}";
        int8[] jb #= json.toBytes();
        s = SampleSelfTest.send(client, resp, url, "application/json", pb, null, jb, (int32) jb.count());
        int8[] back2 #= Bytes.copyOf(resp.body());
        Account acct2 #= Protobuf.parse<Account>(back2, back2.count());
        SampleSelfTest.check(s == 201 && acct2.username != null && acct2.username.equals("jsonpb"),
            "a JSON request answers protobuf when protobuf is accepted");

        String zipped = "{\"username\":\"zipped\",\"password\":\"correct horse\"}";
        int8[] zb #= zipped.toBytes();
        int8[] gz #= ContentCodings.compressor("gzip").compress(zb, zb.count(), 1);
        s = SampleSelfTest.send(client, resp, url, "application/json", null, "gzip", gz, (int32) gz.count());
        SampleSelfTest.check(s == 201, "a gzip-coded JSON body registers (got " + s + ")");

        String plain = "{\"username\":\"coded\",\"password\":\"correct horse\"}";
        int8[] pl #= plain.toBytes();
        String coded #= SampleSelfTest.raw(port, "POST /users HTTP/1.1\r\nContent-Type: application/json\r\nAccept-Encoding: gzip\r\n", pl, (int32) pl.count());
        SampleSelfTest.check(coded.indexOf(" 201 ") >= 0 && SampleSelfTest.hasHeader(coded, "Content-Encoding: gzip"),
            "the answer is gzip-coded when gzip is accepted");

        String xml = "<signup/>";
        int8[] xb #= xml.toBytes();
        s = SampleSelfTest.send(client, resp, url, "application/xml", null, null, xb, (int32) xb.count());
        String unsupported #= resp.bodyString();
        SampleSelfTest.check(s == 415 && unsupported.indexOf(pb) >= 0 && unsupported.indexOf("application/json") >= 0,
            "an unknown media type answers 415 naming JSON and protobuf (" + s + ")");
        s = SampleSelfTest.send(client, resp, url, "application/json", "application/xml", null, jb, (int32) jb.count());
        String unacceptable #= resp.bodyString();
        SampleSelfTest.check(s == 406 && unacceptable.indexOf(pb) >= 0, "an unmet Accept answers 406 naming the types (" + s + ")");

        String br #= SampleSelfTest.raw(port, "POST /users HTTP/1.1\r\nContent-Type: application/json\r\nContent-Encoding: br\r\n", jb, (int32) jb.count());
        SampleSelfTest.check(br.indexOf(" 415 ") >= 0 && SampleSelfTest.hasHeader(br, "Accept-Encoding: "),
            "an unknown content coding answers 415 with Accept-Encoding");
        String refused #= SampleSelfTest.raw(port, "POST /users HTTP/1.1\r\nContent-Type: application/json\r\nAccept-Encoding: br, identity;q=0\r\n", jb, jb.count());
        SampleSelfTest.check(refused.indexOf(" 406 ") >= 0, "a request refusing every coding held answers 406");

        // Spec §11.6: x-reverse exists only in the test profile.
        String rev = "{\"username\":\"reversed\",\"password\":\"correct horse\"}";
        int8[] rb #= rev.toBytes();
        int8[] flipped = heap int8[rb.count()];
        int32 k = 0;
        while (k < rb.count()) {
            flipped[k] = rb[rb.count() - 1 - k];
            k = k + 1;
        }
        String viaTest #= SampleSelfTest.raw(port, "POST /users HTTP/1.1\r\nContent-Type: application/json\r\nContent-Encoding: x-reverse\r\nAccept-Encoding: x-reverse\r\n", flipped, (int32) flipped.count());
        SampleSelfTest.check(viaTest.indexOf(" 201 ") >= 0 && SampleSelfTest.hasHeader(viaTest, "Content-Encoding: x-reverse")
            && viaTest.indexOf("}eslaf:\"demrifnoc\"") >= 0,
            "the test profile's x-reverse coding is negotiated both ways");
        return;
    }

    static async int32 contract(int32 port, MemoryUserPool pool, WebServer web, ArrayList<String> secrets) {
        String base = "http://127.0.0.1:" + port;
        HttpClient client = heap HttpClient();
        ClientResponse resp = heap ClientResponse();

        int32 s = SampleSelfTest.post(client, resp, base + "/users", "{\"username\":\"ada\",\"password\":\"correct horse\"}");
        SampleSelfTest.check(s == 201, "POST /users answers 201 (got " + s + ")");
        String created #= resp.bodyString();
        String id #= SampleSelfTest.field(created, "id");
        SampleSelfTest.check(id.byteLength() > 0, "the 201 body carries the application id");
        SampleSelfTest.check(created.indexOf("\"username\":\"ada\"") >= 0, "the 201 body carries the username");

        s = SampleSelfTest.post(client, resp, base + "/users", "{\"username\":\"ada\",\"password\":\"another one\"}");
        SampleSelfTest.check(s == 409, "a duplicate username answers 409 (got " + s + ")");

        s = SampleSelfTest.post(client, resp, base + "/users", "{\"password\":\"correct horse\"}");
        String missing #= resp.bodyString();
        SampleSelfTest.check(s == 400, "a body without a username answers 400 (got " + s + ")");
        SampleSelfTest.check(missing.indexOf("username") >= 0, "the 400 names the username field");

        s = SampleSelfTest.post(client, resp, base + "/users", "{\"username\":\"bob\",\"password\":\"short\"}");
        String weak #= resp.bodyString();
        SampleSelfTest.check(s == 400 && weak.indexOf("password") >= 0, "a short password answers 400 naming the password field");

        s = SampleSelfTest.post(client, resp, base + "/users", "not json");
        SampleSelfTest.check(s == 400, "a body that is not JSON answers 400 (got " + s + ")");

        SampleSelfTest.pairings(client, resp, base, port);

        s = SampleSelfTest.get(client, resp, base + "/users/" + id);
        String found #= resp.bodyString();
        SampleSelfTest.check(s == 200, "GET /users/{id} answers 200 (got " + s + ")");
        SampleSelfTest.check(found.indexOf("\"username\":\"ada\"") >= 0, "the lookup returns the user");
        SampleSelfTest.check(found.indexOf("\"confirmed\":false") >= 0, "a new user is unconfirmed");

        s = SampleSelfTest.get(client, resp, base + "/users/no-such-id");
        SampleSelfTest.check(s == 404, "an unknown id answers 404 (got " + s + ")");

        String code #= pool.hooks().lastConfirmationCode(SampleSelfTest.subjectOf(pool, "ada"));
        s = SampleSelfTest.post(client, resp, base + "/users/" + id + "/confirm", "{\"code\":\"000000x\"}");
        SampleSelfTest.check(s == 400, "a wrong confirmation code answers 400 (got " + s + ")");
        s = SampleSelfTest.post(client, resp, base + "/users/" + id + "/confirm", "{\"code\":\"" + code + "\"}");
        SampleSelfTest.check(s == 204, "the delivered code confirms through the username (got " + s + ")");
        s = SampleSelfTest.get(client, resp, base + "/users/" + id);
        String confirmed #= resp.bodyString();
        SampleSelfTest.check(confirmed.indexOf("\"confirmed\":true") >= 0, "the lookup reports the confirmation");

        SampleSelfTest.security(client, resp, base, pool, id, secrets);

        // The WebSocket phase (spec §6.7): a subscriber on /events hears every
        // registration, decoded as JSON over its message, with the pool flat.
        WebSocket sub #= WebSocket.connect("ws://127.0.0.1:" + port + "/events");
        int32 waited = 0;
        while (web.connections().count() == 0 && waited < 200) {
            Fiber.sleep(Duration.ofMillis(10));
            waited = waited + 1;
        }
        SampleSelfTest.post(client, resp, base + "/users", "{\"username\":\"eve\",\"password\":\"correct horse\"}");
        WsMessage first #= sub.receive();
        JsonBody ev = heap JsonBody();
        ev.bind(first.bytes(), 0, first.length());
        String who #= ev.stringCopy("registered");
        SampleSelfTest.check(who != null && who.equals("eve"), "a subscriber hears the registration as JSON");
        int32 wsPool = web.bufferAllocations();
        int32 heard = 0;
        int32 n = 0;
        while (n < 50) {
            SampleSelfTest.post(client, resp, base + "/users", "{\"username\":\"sub" + n + "\",\"password\":\"correct horse\"}");
            WsMessage m #= sub.receive();
            ev.bind(m.bytes(), 0, m.length());
            String got #= ev.stringCopy("registered");
            if (got != null && got.equals("sub" + n)) {
                heard = heard + 1;
            }
            n = n + 1;
        }
        SampleSelfTest.check(heard == 50, "50 registrations reach the subscriber in order (" + heard + ")");
        SampleSelfTest.check(web.bufferAllocations() == wsPool,
            "50 WebSocket messages make no fresh buffer (" + (web.bufferAllocations() - wsPool) + ")");
        sub.close(1000, "done");
        waited = 0;
        while (web.connections().count() != 0 && waited < 200) {
            Fiber.sleep(Duration.ofMillis(10));
            waited = waited + 1;
        }
        SampleSelfTest.check(web.connections().count() == 0, "a closed subscriber leaves the registry");

        int32 i = 0;
        while (i < 8) {
            SampleSelfTest.post(client, resp, base + "/users", "{\"username\":\"warm" + i + "\",\"password\":\"correct horse\"}");
            i = i + 1;
        }
        int32 transport = web.bufferAllocations();
        int32 stages = web.buffers().allocations();
        i = 0;
        while (i < 200) {
            s = SampleSelfTest.post(client, resp, base + "/users", "{\"username\":\"user" + i + "\",\"password\":\"correct horse\"}");
            if (s != 201) {
                SampleSelfTest.check(false, "registration " + i + " answers 201 (got " + s + ")");
            }
            i = i + 1;
        }
        SampleSelfTest.check(web.bufferAllocations() == transport,
            "200 registrations on one connection make no fresh transport buffer ("
            + (web.bufferAllocations() - transport) + ")");
        SampleSelfTest.check(web.buffers().allocations() == stages,
            "200 registrations make no fresh pipeline buffer (" + (web.buffers().allocations() - stages) + ")");

        int32 before = web.bufferAllocations();
        i = 0;
        while (i < 20) {
            {
                HttpClient fresh = heap HttpClient();
                ClientResponse r2 = heap ClientResponse();
                SampleSelfTest.get(fresh, r2, base + "/users/" + id);
            }
            // The client has closed; wait for the server to take its two
            // buffers back before dialing again, instead of racing it.
            int32 settle = 0;
            while (web.idleBuffers() < 2 && settle < 200) {
                Fiber.sleep(Duration.ofMillis(5));
                settle = settle + 1;
            }
            i = i + 1;
        }
        SampleSelfTest.check(web.bufferAllocations() - before <= 2,
            "20 sequential connections reuse idle buffers (" + (web.bufferAllocations() - before) + " fresh)");
        return 1;
    }

    static #String subjectOf(MemoryUserPool pool, String username) {
        return pool.lookupByName(username).subject();
    }

    /** One full run: an app over a fresh memory pool, a server on an ephemeral port, the contract, a shutdown. */
    static void once() {
        MemoryUserPool pool = heap MemoryUserPool();
        pool.requireTotp(true);
        RegisterApp app = heap RegisterApp(pool);
        CapturingAppender sink = heap CapturingAppender();
        Logger audit = heap Logger("register-user.security", Level.INFO, heap JsonlEncoder(), sink);
        app.auditTo(audit);
        ArrayList<String> secrets = heap ArrayList<String>();
        SampleSelfTest.secret(secrets, "correct horse");
        scope {
            WebServer web #= RegisterApp.server("127.0.0.1:0", app);
            int32 port = web.port();
            Task<int32> sv = spawn serve(web);
            Task<int32> tc = spawn contract(port, pool, web, secrets);
            SampleSelfTest.check(await tc == 1, "the contract ran to the end");
            web.shutdown(Duration.ofSeconds(2));
            SampleSelfTest.check(await sv == 1, "the accept loop exited");
        }
        SampleSelfTest.noSecretsIn(sink, secrets);
        return;
    }

    // Plan 6.1.4 and spec §11.8, in the test profile: the selector picks the
    // memory driver with identity.provider unset and the app over it starts,
    // and a driver without TOTP refuses startup.
    static void startup() {
        IdentitySelector sel = IdentitySelector.__cajeta_inject();
        SampleSelfTest.check(sel.provider().equals("memory"), "the test profile selects the memory driver unset");
        RegisterApp chosen #= RegisterApp.select();
        WebServer web #= RegisterApp.server("127.0.0.1:0", chosen);
        SampleSelfTest.check(web.port() > 0, "the app over the selected driver starts");

        String[] noTotp = [IdentityCapability.CONFIRMATION(), IdentityCapability.GROUPS(),
            IdentityCapability.REFRESH(), IdentityCapability.REVOCATION()];
        MemoryUserPool stub #= MemoryUserPool.declaring(noTotp);
        RegisterApp lacking = heap RegisterApp(stub);
        String why = "";
        try {
            WebServer refused #= RegisterApp.server("127.0.0.1:0", lacking);
        } catch (SecurityException e) {
            why = "" + e.getMessage();
        }
        SampleSelfTest.check(why.indexOf("identity.totp") >= 0, "a driver without TOTP refuses startup (" + why + ")");
        return;
    }

    // Plan 6.1.5 and spec §11.8: the production build refuses to start until
    // a provider is named.
    static void production(String binary) {
        String[] argv = heap String[2];
        argv[0] = "" + binary;
        argv[1] = "127.0.0.1:0";
        String[] env = heap String[1];
        env[0] = "PATH=/usr/bin:/bin";
        Command cmd = heap Command(#argv);
        cmd.environment(#env);
        cmd.captureStdout();
        cmd.captureStderr();
        cmd.timeoutMillis(20000L);
        ProcessResult r #= cmd.run();
        String out = "";
        if (r.stdout() != null) {
            out = out + Bytes.toString(r.stdout()[0:(int32) r.stdout().count()]);
        }
        if (r.stderr() != null) {
            out = out + Bytes.toString(r.stderr()[0:(int32) r.stderr().count()]);
        }
        SampleSelfTest.check(r.launched() && !r.timedOut() && r.code() != 0 && out.indexOf("identity.provider") >= 0,
            "the production build refuses to start with no provider named (exit " + r.code() + ": " + out + ")");
        return;
    }

    public static int32 run(String[] args) {
        System.stdout.println("=== register-user self-test ===");
        if (args.count() > 0) {
            SampleSelfTest.production(args[0]);
        } else {
            SampleSelfTest.check(false, "the self-test is handed the production build to run");
        }
        SampleSelfTest.startup();
        SampleSelfTest.once();
        int64 live = Cajeta.liveCount();
        SampleSelfTest.once();
        int64 after = Cajeta.liveCount();

        SampleSelfTest.check(after == live, "the live count is equal across a whole run (" + (after - live)
            + "); it is blind to arrays, which the pool counters cover");
        System.stdout.println("register-user: " + (SampleSelfTest.checks - SampleSelfTest.failures)
            + " of " + SampleSelfTest.checks + " checks passed");
        return SampleSelfTest.failures == 0 ? 0 : 1;
    }
}
