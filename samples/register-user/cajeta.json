{
    // The registration sample (primavera-web spec §5.6): its own project over
    // the published primavera, cajeta-http and cajeta-cloud archives, run by
    // the primavera repo's test task so it cannot rot.
    "details": {
        "name":               "dev.cajeta.sample.register",
        "version":            "0.1.0",
        "description":        "primavera sample: register, look up and confirm a user over HTTP",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        "toolchain": {
            "version": "0.35.0",
            "from":    "https://olla.cajeta.dev"
        },
        "capabilities": [],
        "dependencies": {
            "dev.cajeta.primavera": "0.2.1",
            "dev.cajeta.http":      "0.5.0",
            "dev.cajeta.cloud":     "0.2.1"
        },
        "dev-dependencies": {},
        "repositories": [
            { "name": "olla", "url": "https://olla.cajeta.dev", "priority": 0 }
        ],
        "build": { "target": "host" }
    },

    "tasks": {
        "build": {
            "description": "Build the sample server",
            "actions": [
                { "action": "build", "flavor": "debug",
                  "entry-method": "dev.cajeta.sample.register.RegisterApp.main", "id": "app" }
            ],
            "outputs": { "path": "${app.path}" }
        },

        "run": {
            "description": "Serve the sample on 127.0.0.1:8080",
            "actions": [
                { "action": "build", "flavor": "debug",
                  "entry-method": "dev.cajeta.sample.register.RegisterApp.main", "id": "app" },
                { "action": "exec", "command": "${app.path}", "args": [] }
            ]
        },

        "test": {
            "description": "Build and run the sample's self-test",
            "actions": [
                { "action": "build", "flavor": "debug", "profile": "test",
                  "entry-method": "dev.cajeta.sample.register.SampleSelfTest.run",
                  "id": "testbin" },
                { "action": "test", "input": "${testbin.path}" }
            ]
        }
    }
}
